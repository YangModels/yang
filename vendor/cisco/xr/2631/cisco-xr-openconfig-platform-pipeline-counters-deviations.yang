  }

  // Deviation for oversubscription
  deviation "/oc-platform:components/oc-platform:component/oc-platform:integrated-circuit/oc-ppc:pipeline-counters/oc-ppc:drop/oc-ppc:lookup-block/oc-ppc:state/oc-ppc:oversubscription" {
    deviate not-supported;
    description
      "Oversubscription drops counter is not supported on this platform.";
  }
}
