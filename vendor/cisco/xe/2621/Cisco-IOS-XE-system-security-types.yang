module Cisco-IOS-XE-system-security-types {
  yang-version 1.1;
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-system-security-types";
  prefix system-security-types-ios-xe-oper;

  import cisco-semver {
    prefix cisco-semver;
  }

  organization
    "Cisco Systems, Inc.";
  contact
    "Cisco Systems, Inc.
     Customer Service

     Postal: 170 W Tasman Drive
     San Jose, CA 95134

     Tel: +1 1800 553-NETS

     E-mail: cs-yang@cisco.com";
  description
    "This module contains a collection of YANG definitions
     for operational data related to system security types.
     Copyright (c) 2026 by Cisco Systems, Inc.
     All rights reserved.";

  revision 2026-08-01 {
    description
      "- Added an enumeration value for TFTP server configuration command
       - Added enum for Tool Command Line module.
       - Added reason, remedy and description enums for Tool Command Language and Logging.
       - Added description enums for Parser module.
       - Added reason, remedy and description enums for SNMP File transfer.
       - Added enum value for Device Sensor module.
       - Added submode enum value for Device Sensor DHCP filter list configuration.
       - Added an enumeration for SSH EC weak host key
       - Added reason, remedy, description, and submode enums for AAA weak password/key
       - Added description enum for boot system insecure file transfer protocol
       - Added module enum for IFS module
       - Added module enum for Crypto PKI Trustpoint module
       - Added description enum for Crypto PKI insecure file transfer protocol
       - Added submode enum for crypto-ca-trustpoint
       - Added dedicated remedy enum for generic secure protocol usage
       - Added module enum for DHCP snooping module
       - Added enum for DHCP module
       - Added remedy and description enums for DHCP
       - Added module enums for voice configuration contexts
       - Added remedy enum for insecure real-time streaming transport usage
       - Added description enums for insecure voice URL and transport configurations
       - Added submode enums for voice configuration contexts
       - Added reason, remediation and description enums for service password-encryption.
       - Added module enum for macro command and description enum for macro auto execute CLI.
       - Added reason, remedy, and description enums for RADIUS Message Authenticator warnings
       - Added description enums for RADIUS, TACACS, and LDAP without TLS warnings
       - Added description enum for Tool Command Language encoding directory
       - Added reason for SNMP group and remediation for SNMP group and cipher AES
       - Added module enums for IVR, gateway accounting, call leg, application monitor, and web service
       - Added description enums for IVR voice prompts, gateway accounting, call leg, event log, and web service configurations
       - Added submode enums for gateway accounting and application monitor configurations
       - Added reason, remedy and description enums for NTP allow mode control
       - Added description enum for NTP without authentication
       - Added module, description, and submode enums for IP SLA insecure protocol
       - Added submode enums for IP SLA LSR path echo and jitter configuration
       - Added module, reason, remediation and description enums for the insecure gNxI server
       - Updated SNMP no ACL reason and remedy descriptions
       - Added module and description enums for Crimson Function Tracking (CRFT) collect-on-reload insecure protocol";
    reference
      "1.1.0";
    cisco-semver:module-version "1.1.0";
  }
  revision 2026-02-01 {
    description
      "Initial revision";
    reference
      "1.0.0";
    cisco-semver:module-version "1.0.0";
  }

  typedef insec-conf-module {
    type enumeration {
      enum module-unknown {
        value 0;
        description
          "Unknown module";
      }
      enum module-aaa {
        value 1;
        description
          "AAA module";
      }
      enum module-bootp {
        value 2;
        description
          "BOOTP module";
      }
      enum module-http {
        value 3;
        description
          "HTTP module";
      }
      enum module-cdp {
        value 4;
        description
          "CDP module";
      }
      enum module-ip {
        value 5;
        description
          "IP module";
      }
      enum module-transport {
        value 6;
        description
          "TRANSPORT module";
      }
      enum module-tftp {
        value 7;
        description
          "TFTP module";
      }
      enum module-telnet {
        value 8;
        description
          "TELNET module";
      }
      enum module-rcmd {
        value 9;
        description
          "Route Convergence Monitoring and Diagnostics module";
      }
      enum module-line {
        value 10;
        description
          "LINE module";
      }
      enum module-ftp {
        value 11;
        description
          "FTP module";
      }
      enum module-ntp {
        value 12;
        description
          "NTP module";
      }
      enum module-snmp {
        value 13;
        description
          "SNMP module";
      }
      enum module-sanet {
        value 14;
        description
          "SANET module";
      }
      enum module-cts {
        value 15;
        description
          "CTS module";
      }
      enum module-parser {
        value 16;
        description
          "PARSER module";
      }
      enum module-logging {
        value 17;
        description
          "LOGGING module";
      }
      enum module-dspfarm-profile {
        value 18;
        description
          "DSPFARM PROFILE module";
      }
      enum module-stcapp {
        value 19;
        description
          "SCCP Telephony Control Application module";
      }
      enum module-ssh {
        value 20;
        description
          "SSH module";
      }
      enum module-capwap {
        value 21;
        description
          "CAPWAP module";
      }
      enum module-voice {
        value 22;
        description
          "Indicates that the insecure configuration was detected in the Voice module.";
      }
      enum module-http-client {
        value 23;
        description
          "Indicates that the insecure configuration was detected in the HTTP client module.";
      }
      enum module-call-mgr {
        value 24;
        description
          "Indicates that the insecure configuration was detected in the Call manager module.";
      }
      enum module-sipua {
        value 25;
        description
          "Indicates that the insecure configuration was detected in the SIP user agent module.";
      }
      enum module-tls-tunnel {
        value 26;
        description
          "Indicates that the insecure configuration was detected in the TLS tunnel module.";
      }
      enum module-nmsp {
        value 27;
        description
          "Indicates that the insecure configuration was detected in the NMSP module.";
      }
      enum module-tcl-bleed {
        value 28;
        description
          "Indicates that the insecure configuration was detected in the Tool Command Line module.";
      }
      enum module-device-sensor {
        value 29;
        description
          "Indicates that the insecure configuration was detected in the DEVICE SENSOR module.";
      }
      enum module-ifs {
        value 30;
        description
          "Indicates that the insecure configuration was detected in the IFS module.";
      }
      enum module-cryptopki-tp {
        value 31;
        description
          "Indicates that the insecure configuration was detected in the Crypto PKI Trustpoint module.";
      }
      enum module-dhcp-snoop {
        value 32;
        description
          "Indicates that the insecure configuration was detected in the DHCP snooping module.";
      }
      enum module-dhcp {
        value 33;
        description
          "Indicates that the insecure configuration was detected in the DHCP module.";
      }
      enum module-config-voice-default {
        value 34;
        description
          "Indicates that the insecure configuration was detected in default voice configuration mode.";
      }
      enum module-config-voice {
        value 35;
        description
          "Indicates that the insecure configuration was detected in voice configuration mode.";
      }
      enum module-config-voice-app {
        value 36;
        description
          "Indicates that the insecure configuration was detected in voice application configuration mode.";
      }
      enum module-config-voice-reg-global {
        value 37;
        description
          "Indicates that the insecure configuration was detected in global voice registration mode.";
      }
      enum module-config-voice-dnismaps {
        value 38;
        description
          "Indicates that the insecure configuration was detected in voice DNIS map configuration mode.";
      }
      enum module-macro {
        value 39;
        description
          "Indicates that the insecure configuration was detected in the macro command module.";
      }
      enum module-ivr {
        value 40;
        description
          "Indicates that the insecure configuration was detected in the IVR module.";
      }
      enum module-gw-acct {
        value 41;
        description
          "Indicates that the insecure configuration belongs to the gateway accounting module.";
      }
      enum module-call-leg {
        value 42;
        description
          "Indicates that the insecure configuration was detected in the call leg module.";
      }
      enum module-app-mon {
        value 43;
        description
          "Indicates that the insecure configuration was detected in the application monitor module.";
      }
      enum module-web-svc {
        value 44;
        description
          "Indicates that the insecure configuration was detected in the web service module.";
      }
      enum module-ipsla {
        value 45;
        description
          "Indicates that the insecure configuration was detected in the IP SLA module.";
      }
      enum module-gnxi {
        value 46;
        description
          "Indicates that insecure configuration was detected in the gNxI (gNMI/gNOI) module";
      }
      enum module-crft {
        value 47;
        description
          "Indicates that insecure configuration was detected in the CRFT collect-on-reload module.";
      }
    }
    description
      "IOS-XE software module owning insecure configuration CLI";
  }

  typedef insec-conf-reason {
    type enumeration {
      enum reason-unknown {
        value 0;
        description
          "Not specified";
      }
      enum reason-weak-encr-for-pwd {
        value 1;
        description
          "Configuration employs an insecure method for password storage";
      }
      enum reason-no-sec-login {
        value 2;
        description
          "The secure login-block feature is un-configured";
      }
      enum reason-legacy-proto {
        value 3;
        description
          "Legacy protocol poses data confidentiality and integrity risks
           due to lack of encryption and authentication";
      }
      enum reason-tls-ver {
        value 4;
        description
          "Weak TLS version";
      }
      enum reason-cipher {
        value 5;
        description
          "Weak cipher(s) are present in the command";
      }
      enum reason-on-demand-routing {
        value 6;
        description
          "On demand routing need to be disabled as in conjunction
           with cdp protocol static default routes will be added";
      }
      enum reason-ip-finger-insec {
        value 7;
        description
          "IP finger service can potentially expose system information to
           unauthorized users";
      }
      enum reason-ip-src-insec {
        value 8;
        description
          "IP source routing allows attackers to bypass network security
           controls and routing policies";
      }
      enum reason-tcp-small-srvr {
        value 9;
        description
          "TCP small servers expose unnecessary network services and
           potential attack vectors";
      }
      enum reason-udp-small-srvr {
        value 10;
        description
          "UDP small servers expose unnecessary network services and
           potential attack vectors";
      }
      enum reason-no-auth {
        value 11;
        description
          "SNMP host with auth/no-auth security level";
      }
      enum reason-insec-hash {
        value 12;
        description
          "Insecure hash digest";
      }
      enum reason-no-acl {
        value 13;
        description
          "Indicates that an SNMP user is configured without an ACL.";
      }
      enum reason-weak-auth-meth {
        value 14;
        description
          "A weak authentication method is being configured
           as part of EAP profile";
      }
      enum reason-no-sec-webauth {
        value 15;
        description
          "Secure web authentication is disabled, forcing insecure web-based
           authentication via HTTP";
      }
      enum reason-without-tls {
        value 16;
        description
          "TLS is not configured, exposing traffic to potential eavesdropping";
      }
      enum reason-ntp-lack-auth {
        value 17;
        description
          "NTP configuration lacks authentication, allowing potential time
           manipulation attacks";
      }
      enum reason-ssh-insuff-key-len {
        value 18;
        description
          "SSH host key uses insufficient key length";
      }
      enum reason-no-encr {
        value 19;
        description
          "No encryption is configured";
      }
      enum reason-zero-idle {
        value 20;
        description
          "Telnet sessions are not configured with an idle timeout";
      }
      enum reason-ip-no-encr {
        value 21;
        description
          "IP traffic is not encrypted";
      }
      enum reason-snmp-user-no-auth-no-priv {
        value 22;
        description
          "SNMP user without authentication
           and privacy security level";
      }
      enum reason-test-reason {
        value 23;
        description
          "Test reason";
      }
      enum reason-weak-file-trans-proto {
        value 24;
        description
          "It indicates that a weak file transfer protocol (FTP, TFTP, RCP, or HTTP)
           is in use";
      }
      enum reason-use-of-weak-pwd-or-key {
        value 25;
        description
          "Password or key does not meet security requirements due to
           insufficient complexity or use of default keywords";
      }
      enum reason-srv-pwd-enc {
        value 26;
        description
          "Indicates that passwords and keys are encrypted with weak Type 7 encryption.";
      }
      enum reason-nosrv-pwd-enc {
        value 27;
        description
          "Indicates that passwords and keys are stored in plaintext";
      }
      enum reason-send-ma-not-enabled {
        value 28;
        description
          "RADIUS Message-Authenticator send is not enabled on this
           server or client configuration";
      }
      enum reason-vali-ma-not-enabled {
        value 29;
        description
          "RADIUS Message-Authenticator validation is not enabled on this
           server or client configuration";
      }
      enum reason-group-no-auth {
        value 30;
        description
          "Indicates an SNMP group configured with no-auth security level.";
      }
      enum reason-ntp-allow-mode-ctrl-ddos {
        value 31;
        description
          "NTP allow mode control renders device susceptible to
           Distributed Denial of Service (DDoS) attacks";
      }
      enum reason-gnxi-no-tls-no-auth {
        value 32;
        description
          "The insecure gNxI (gNMI/gNOI) gRPC server is unencrypted and does not support authentication";
      }
    }
    description
      "Reason enum for configuration CLI being marked insecure";
  }

  typedef insec-conf-remedy {
    type enumeration {
      enum remedy-unknown {
        value 0;
        description
          "Not specified";
      }
      enum remedy-sec-opt-type6 {
        value 1;
        description
          "Consider migrating to a secure alternative such as type-6";
      }
      enum remedy-sec-opt-sha-aes {
        value 2;
        description
          "Transition to more secure algorithms like SHA and AES";
      }
      enum remedy-cfg-sec-login {
        value 3;
        description
          "Consider re-configuring it for protecting against DoS attacks";
      }
      enum remedy-use-dhcp {
        value 4;
        description
          "Use DHCP to automatically configure network settings";
      }
      enum remedy-use-http-sec-srvr {
        value 5;
        description
          "Use http secure server to ensure secure web access";
      }
      enum remedy-use-stronger-tls-ver {
        value 6;
        description
          "Use stronger tls version to enhance security";
      }
      enum remedy-use-stronger-cipher {
        value 7;
        description
          "Use stronger cipher(s) to enhance security";
      }
      enum remedy-obsolete {
        value 8;
        description
          "This is a legacy feature, need to disable the feature";
      }
      enum remedy-ssh-show-cmds {
        value 9;
        description
          "Disable finger service and use secure SSH-based
           show commands for system information retrieval";
      }
      enum remedy-disable-ping-tr-ssh {
        value 10;
        description
          "Disable TCP small servers and use modern network diagnostic tools
           like ping, traceroute, or SSH-based commands";
      }
      enum remedy-use-scp-sftp {
        value 11;
        description
          "Transition to secure file transfer methods
           using SCP, SFTP, HTTPS protocols";
      }
      enum remedy-use-ssh {
        value 12;
        description
          "Migrate to secure SSH-based remote access";
      }
      enum remedy-snmpv3 {
        value 13;
        description
          "Configure snmp version 3 user";
      }
      enum remedy-snmp-priv-sec {
        value 14;
        description
          "Use SNMP host with Private security level";
      }
      enum remedy-snmp-sha-sha2 {
        value 15;
        description
          "Use secure hash digest such as sha and sha-2";
      }
      enum remedy-snmp-3des {
        value 16;
        description
          "Use secure cipher such as 3des";
      }
      enum remedy-snmp-with-acl {
        value 17;
        description
          "Indicates that the remedy is to configure an ACL for the SNMP user.";
      }
      enum remedy-strong-auth-meth {
        value 18;
        description
          "Please consider configuring a stronger method
           such as EAP-FAST, EAP-PEAP or EAP-TLS";
      }
      enum remedy-webauth-https {
        value 19;
        description
          "Remove secure-webauth-disable configuration to ensure secure
           web-based authentication via HTTPS";
      }
      enum remedy-use-sec-encr {
        value 20;
        description
          "Use secure encryption methods to protect sensitive data";
      }
      enum remedy-conf-sec-opts-under-srvr {
        value 21;
        description
          "Configure secure options under server to enhance security";
      }
      enum remedy-ntp-make-authkey-trusted {
        value 22;
        description
          "Please make the configured auth key trusted using the
           command - ntp trusted-key";
      }
      enum remedy-ntp-conf-authkey-trusted {
        value 23;
        description
          "Configure a valid auth key and make it trusted using the
           command - ntp trusted-key";
      }
      enum remedy-ntp-auth {
        value 24;
        description
          "Configure ntp authenticate command to enable NTP authentication";
      }
      enum remedy-ssh-rsa-3072-key-len {
        value 25;
        description
          "Use SSH RSA host key with a minimum length of 3072 bits for
           enhanced security";
      }
      enum remedy-ssh-ec-384-key-len {
        value 26;
        description
          "Use SSH EC host key with a minimum length of 384 bits for
           enhanced security";
      }
      enum remedy-sec-opt-type6-9 {
        value 27;
        description
          "Please consider migrating to a secure alternative
           such as type-6 or type-9";
      }
      enum remedy-snmp-auth-priv {
        value 28;
        description
          "Use SNMP user with authentication and privacy";
      }
      enum remedy-test {
        value 29;
        description
          "Test remediation";
      }
      enum remedy-ssh-ec-256-key-len {
        value 30;
        description
          "Use SSH EC host key with a minimum length of 256 bits for
           enhanced security";
      }
      enum remedy-use-sec-file-trans-proto {
        value 31;
        description
          "It indicates that the remediation is to use a secure file transfer
           protocol (SFTP, HTTPS, or SCP)";
      }
      enum remedy-use-strong-pwd-or-key {
        value 32;
        description
          "Configure a password or key that meets the AAA common-criteria
           default policy requirements";
      }
      enum remedy-use-sec-proto {
        value 33;
        description
          "It indicates that the remediation is to use a crypto secure protocol
           instead of an insecure one";
      }
      enum remedy-dhcp-bootp-ignore-enable {
        value 34;
        description
          "Keep 'ip dhcp bootp ignore' enabled to block legacy BOOTP clients and prevent security vulnerabilities";
      }
      enum remedy-use-sec-proto-generic {
        value 35;
        description
          "Use secure protocols such as HTTPS, SFTP, or SCP instead of
           insecure HTTP, FTP, or TFTP";
      }
      enum remedy-use-sec-proto-srtp {
        value 36;
        description
          "Use secure real-time streaming protocols instead of plain
           real-time streaming transport";
      }
      enum remedy-use-secure-pwd-enc {
        value 37;
        description
          "Indicates that stronger encryption methods such as Type 6/8/9
           should be used where supported, and that this command should not be relied upon alone";
      }
      enum remedy-enable-send-ma {
        value 38;
        description
          "Enable send-ma on the RADIUS server or client configuration
           to protect against Blast Radius attacks";
      }
      enum remedy-enable-vali-ma {
        value 39;
        description
          "Enable validate-ma on the RADIUS server or client configuration
           to protect against Blast Radius attacks";
      }
      enum remedy-snmp-group-priv-sec {
        value 40;
        description
          "Indicates that the SNMP group uses the Private security level.";
      }
      enum remedy-snmp-aes {
        value 41;
        description
          "Indicates that a secure cipher such as AES is used.";
      }
      enum remedy-ntp-rate-limit-ctrl-mode {
        value 42;
        description
          "If NTP control mode needs to be enabled, configure a higher
           rate-limit delay and monitor the flow";
      }
      enum remedy-use-gnxi-sec-srvr {
        value 43;
        description
          "Configure the TLS-encrypted gNxI secure-server
           along with an authentication method such as password authentication
           or client certificate authentication.";
      }
      enum remedy-use-gnxi-tunnel-sec {
        value 44;
        description
          "Configure the secure gRPC tunnel target type.";
      }
    }
    description
      "Remedy enum for insecure configuration CLI";
  }

  typedef insec-conf-desc {
    type enumeration {
      enum unknown {
        value 0;
        description
          "Not specified";
      }
      enum username-pwd-0-5-7 {
        value 1;
        description
          "Username password configured with weak encryption
           (type 0, 7, or plain text) instead of secure type 6 encryption";
      }
      enum rad-srvr-key-weak-encr {
        value 2;
        description
          "RADIUS server key configured with weak encryption
           (type 0, 7, or plain text) instead of secure type 6 encryption";
      }
      enum rad-srvr-pac-key-weak-encr {
        value 3;
        description
          "RADIUS server PAC key configured with weak encryption
           (type 0, 7, or plain text) instead of secure type 6 encryption";
      }
      enum rad-srvr-key-wrap-weak-encr {
        value 4;
        description
          "RADIUS server key-wrap encryption or message auth code key
           configured with weak encryption instead of secure type 6";
      }
      enum tacacs-srvr-key-weak-encr {
        value 5;
        description
          "TACACS server key configured with weak encryption
           (type 0, 7, or plain text) instead of secure type 6 encryption";
      }
      enum rad-grp-srvr-priv-key-weak-encr {
        value 6;
        description
          "RADIUS group server private key configured with weak encryption
           instead of secure type 6 encryption";
      }
      enum rad-da-cient-srvr-key-weak-encr {
        value 7;
        description
          "RADIUS dynamic authorization client server-key configured with
           weak encryption instead of secure type 6";
      }
      enum ldap-srvr-key-weak-encr {
        value 8;
        description
          "LDAP server key configured with weak encryption
           (type 0, 7, or plain text) instead of secure type 6 encryption";
      }
      enum aaa-auth-pwd-weak-encr {
        value 9;
        description
          "AAA authentication password configured with weak encryption
           instead of secure type 6 encryption";
      }
      enum global-rad-srvr-key-weak-encr {
        value 10;
        description
          "Global RADIUS server key configured with weak encryption
           instead of secure type 6 encryption";
      }
      enum rad-sesm-srvr-key-weak-encr {
        value 11;
        description
          "RADIUS SES Manager server key configured with weak encryption
           instead of secure type 6 encryption";
      }
      enum rad-sesm-client-key-weak-encr {
        value 12;
        description
          "RADIUS SES Manager client key configured with weak encryption
           instead of secure type 6 encryption";
      }
      enum rad-proxy-srvr-key-weak-encr {
        value 13;
        description
          "RADIUS proxy server key configured with weak encryption
           instead of secure type 6 encryption";
      }
      enum en-pwd-weak-encr {
        value 14;
        description
          "Enable password configured with weak encryption
           instead of secure type 6 or 9 encryption";
      }
      enum rad-pol-dev-srvr-key-weak-encr {
        value 15;
        description
          "RADIUS policy device server key configured with weak encryption
           instead of secure type 6 encryption";
      }
      enum rad-pol-dev-client-key-weak-encr {
        value 16;
        description
          "RADIUS policy device client key configured with weak encryption
           instead of secure type 6 encryption";
      }
      enum global-tacacs-srvr-key-weak-encr {
        value 17;
        description
          "Global TACACS server key configured with weak encryption
           instead of secure type 6 encryption";
      }
      enum tacacs-grp-srvr-priv-key-weak-encr {
        value 18;
        description
          "TACACS group server private key configured with weak encryption
           instead of secure type 6 encryption";
      }
      enum login-blocking-disabled {
        value 19;
        description
          "Login blocking disabled - removes protection against
           brute force attacks";
      }
      enum bootp-srvr-legacy-proto {
        value 20;
        description
          "BOOTP server enabled - legacy protocol vulnerable to
           man-in-the-middle attacks and lacks security features";
      }
      enum http-srvr-unencr-proto {
        value 21;
        description
          "HTTP server enabled - unencrypted protocol vulnerable to
           eavesdropping and man-in-the-middle attacks";
      }
      enum http-client-weak-tls-ver {
        value 22;
        description
          "HTTP client configured with weak TLS version 1.0 or
           1.1 - vulnerable to various cryptographic attacks";
      }
      enum http-client-weak-cipher {
        value 23;
        description
          "HTTP client using weak cipher suite with CBC mode and
           SHA-1 - vulnerable to padding oracle and collision attacks";
      }
      enum odr-obs-routing-proto {
        value 24;
        description
          "On-Demand Routing enabled - obsolete routing protocol
           with security vulnerabilities";
      }
      enum ip-finger-svc-en {
        value 25;
        description
          "IP finger service enabled - provides system information that
           can be used for reconnaissance attacks";
      }
      enum finger-svc-en {
        value 26;
        description
          "Finger service enabled - provides detailed user information
           that can be exploited for social engineering";
      }
      enum ip-src-routing-en {
        value 27;
        description
          "IP source routing enabled - allows attackers to specify packet
