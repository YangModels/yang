module Cisco-IOS-XE-l2vpn-oper {
  yang-version 1.1;
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-l2vpn-oper";
  prefix l2vpn-ios-xe-oper;

  import ietf-inet-types {
    prefix inet;
  }
  import ietf-yang-types {
    prefix yang;
  }
  import cisco-semver {
    prefix cisco-semver;
  }

  organization
    "Cisco Systems, Inc.";
  contact
    "Cisco Systems, Inc.
     Customer Service

     Postal: 170 W Tasman Drive
     San Jose, CA 95134

     Tel: +1 1800 553-NETS

     E-mail: cs-yang@cisco.com";
  description
    "This module contains a collection of YANG definitions
     for L2VPN services operational data.
     Copyright (c) 2022-2026 by Cisco Systems, Inc.
     All rights reserved.";

  revision 2026-08-01 {
    description
      "Updated descriptions of several model elements to clarify their meaning and purpose.";
    reference
      "1.1.1";
    cisco-semver:module-version "1.1.1";
  }
  revision 2023-03-01 {
    description
      "- Added more detailed PW info to the l2vpn-atom-vc-data
       - Added MAC withdraw counters to VC statistics";
    reference
      "1.1.0";
    cisco-semver:module-version "1.1.0";
  }
  revision 2022-11-01 {
    description
      "Initial revision";
    reference
      "1.0.0";
    cisco-semver:module-version "1.0.0";
  }

  typedef l2vpn-service-type {
    type enumeration {
      enum l2vpn-service-invalid {
        value 0;
        description
          "Invalid L2VPN service type.";
      }
      enum l2vpn-service-vpws {
        value 1;
        description
          "L2VPN service type Virtual Private Wire Service (VPWS).";
      }
      enum l2vpn-service-vpls {
        value 2;
        description
          "L2VPN service type Virtual Private LAN Service (VPLS).";
      }
      enum l2vpn-service-transport {
        value 3;
        description
          "L2VPN service type Transport.";
      }
      enum l2vpn-service-bd {
        value 4;
        description
          "L2VPN service type Bridge Domain (BD).";
      }
      enum l2vpn-service-evpn {
        value 5;
        description
          "L2VPN service type Ethernet Virtual Private Network (EVPN).";
      }
    }
    description
      "L2VPN service type.";
  }

  typedef l2vpn-ac-circuit-type {
