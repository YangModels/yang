        value 21;
        description
          "L2VPN interworking type Asynchronous Transfer Mode (ATM) Virtual Circuit (VC) unknown.";
      }
      enum l2vpn-iw-atm-vp-unknown {
        value 22;
        description
          "L2VPN interworking type Asynchronous Transfer Mode (ATM) Virtual Path (VP) unknown.";
      }
      enum l2vpn-iw-atom {
        value 23;
        description
          "L2VPN interworking type Any Transport over MPLS (ATOM).";
      }
      enum l2vpn-iw-l2tpv2 {
        value 24;
        description
          "L2VPN interworking type Layer 2 Tunneling Protocol Version 2 (L2TPv2).";
      }
      enum l2vpn-iw-l2tpv3 {
        value 25;
        description
          "L2VPN interworking type Layer 2 Tunneling Protocol Version 3 (L2TPv3).";
      }
      enum l2vpn-iw-pw-udp {
        value 26;
        description
          "L2VPN interworking type Pseudowire (PW) over UDP.";
      }
      enum l2vpn-iw-docsis {
        value 27;
        description
          "L2VPN interworking type Data Over Cable Service Interface Specification (DOCSIS).";
      }
      enum l2vpn-iw-docsis-vlan {
        value 28;
        description
          "L2VPN interworking type Data Over Cable Service Interface Specification (DOCSIS) VLAN.";
      }
    }
    description
      "L2VPN interworking type.";
  }

  typedef l2vpn-service-state {
    type enumeration {
      enum l2vpn-serv-undef {
        value 0;
        description
          "L2VPN service state undefined.";
      }
      enum l2vpn-serv-up {
        value 1;
        description
          "L2VPN service state up.";
      }
      enum l2vpn-serv-down {
        value 2;
        description
          "L2VPN service state down.";
      }
      enum l2vpn-serv-admin-down {
        value 3;
        description
          "L2VPN service state admin down.";
      }
      enum l2vpn-serv-recovering {
        value 4;
        description
          "L2VPN service state recovering.";
      }
      enum l2vpn-serv-stdby {
        value 5;
        description
          "L2VPN service state standby.";
      }
      enum l2vpn-serv-hot-stdby {
        value 6;
        description
          "L2VPN service state hot standby.";
      }
    }
    description
      "L2VPN service state.";
  }

  typedef l2vpn-vccv-cc-type-flags {
    type bits {
      bit vccv-cc-cw {
        position 0;
        description
          "L2VPN VCCV CC type control word.";
      }
      bit vccv-cc-ra {
        position 1;
        description
          "L2VPN VCCV CC type router alert.";
      }
      bit vccv-cc-ttl {
        position 2;
        description
          "L2VPN VCCV CC type Time-To-Live (TTL).";
      }
    }
    description
      "L2VPN Virtual Circuit Connectivity Verification (VCCV) control channel (CC) type flags.";
  }

  typedef l2vpn-vccv-cv-type-flags {
    type bits {
      bit vccv-cv-icmp {
        position 0;
        description
          "L2VPN VCCV CV type Internet Control Message Protocol (ICMP).";
      }
      bit vccv-cv-lspv {
        position 1;
        description
          "L2VPN VCCV CV type Label Switched Path Verification (LSPV).";
      }
      bit vccv-cv-bfd-udp {
        position 2;
        description
          "L2VPN VCCV CV type Bidirectional Forwarding Detection (BFD) over UDP.";
      }
      bit vccv-cv-bfd-udp-sig {
        position 3;
        description
          "L2VPN VCCV CV type Bidirectional Forwarding Detection (BFD) over UDP with signalling.";
      }
      bit vccv-cv-bfd-raw {
        position 4;
        description
          "L2VPN VCCV CV type Bidirectional Forwarding Detection (BFD) RAW.";
      }
      bit vccv-cv-bfd-raw-sig {
        position 5;
        description
          "L2VPN VCCV CV type Bidirectional Forwarding Detection (BFD) RAW with signalling.";
      }
    }
    description
      "L2VPN Virtual Circuit Connectivity Verification (VCCV) connectivity verification (CV) type flags.";
  }

  grouping fwd-info-ac {
    description
      "L2VPN forwarder info for attachment circuit";
    leaf if-name {
      type string;
      description
        "Name of the interface used as the attachment circuit for this L2VPN xconnect segment.";
    }
    leaf group-name {
      type string;
      description
        "Name of the group to which the attachment circuit belongs, used for grouping related circuits in L2VPN configuration.";
    }
    leaf encap {
      type l2vpn-ios-xe-oper:l2vpn-ac-circuit-type;
      description
        "Type of encapsulation used on the attachment circuit for this L2VPN xconnect segment, such as Ethernet or VLAN tagging.";
    }
    leaf state {
      type l2vpn-ios-xe-oper:l2vpn-xconnect-segment-state;
      description
        "Current operational state of the attachment circuit for this L2VPN xconnect segment, such as up, down, or administratively down.";
    }
    leaf state-in-l2vpn-service {
      type l2vpn-ios-xe-oper:l2vpn-xconnect-state;
      description
        "Operational state of the attachment circuit as it pertains specifically to its role within the L2VPN service.";
    }
    leaf priority {
      type uint32;
      description
        "Priority value assigned to the attachment circuit for determining failover or selection order within the L2VPN configuration.";
    }
  }

  grouping fwd-info-pw {
    description
      "L2VPN forwarder info for pseudo-wire";
    leaf if-name {
      type string;
      description
        "Name of the interface associated with the L2VPN pseudo-wire.";
    }
    leaf group-name {
      type string;
      description
        "Name of the pseudo-wire group to which this L2VPN pseudo-wire belongs.";
    }
    leaf encap {
      type l2vpn-ios-xe-oper:l2vpn-pw-encap-type;
      description
        "Indicates the encapsulation type used for the L2VPN pseudo-wire, such as MPLS or L2TPv3.";
    }
    leaf peer-address {
      type inet:ipv4-address;
      description
        "Pseudo-wire peer ipv4 address";
    }
    leaf vcid {
      type uint32;
      description
        "Pseudo-wire virtual circuit id";
    }
    leaf state {
      type l2vpn-ios-xe-oper:l2vpn-xconnect-segment-state;
      description
        "Indicates the current operational state of the pseudowire, such as up, down, or administratively shut.";
    }
    leaf state-in-l2vpn-service {
      type l2vpn-ios-xe-oper:l2vpn-xconnect-state;
      description
        "Indicates the operational state of the pseudo-wire as it relates to the overall L2VPN service.";
    }
    leaf priority {
      type uint32;
      description
        "Specifies the priority value assigned to the L2VPN pseudo-wire, which determines its selection order in failover or load balancing scenarios.";
    }
  }

  grouping fwd-info-vfi {
    description
      "L2VPN forwarder info for Virtual Forwarding Instance (VFI).";
    leaf if-name {
      type string;
      description
        "Name of the interface associated with the VPLS Virtual Forwarding Instance (VFI).";
    }
    leaf group-name {
      type string;
      description
        "Name of the VPLS group to which this VFI segment belongs.";
    }
    leaf encap {
      type l2vpn-ios-xe-oper:l2vpn-pw-encap-type;
      description
        "Specifies the encapsulation type used for the VPLS Virtual Forwarding Instance (VFI), such as MPLS.";
    }
    leaf state {
      type l2vpn-ios-xe-oper:l2vpn-xconnect-segment-state;
      description
        "Current operational state of the VPLS Virtual Forwarding Instance (VFI) segment.";
    }
    leaf state-in-l2vpn-service {
      type l2vpn-ios-xe-oper:l2vpn-xconnect-state;
      description
        "Current state of this VPLS Virtual Forwarding Instance (VFI) segment within the overall L2VPN service.";
    }
    leaf priority {
      type uint32;
      description
        "Priority value assigned to this VPLS Virtual Forwarding Instance (VFI) segment for traffic handling or failover.";
    }
  }

  grouping fwd-info-bd {
    description
      "L2VPN forwarder info for bridge domain.";
    leaf if-name {
      type string;
      description
        "Name of the interface associated with this L2VPN bridge domain.";
    }
    leaf group-name {
      type string;
      description
        "Name of the group to which this L2VPN bridge domain belongs.";
    }
    leaf encap {
      type l2vpn-ios-xe-oper:l2vpn-pw-encap-type;
      description
        "Type of encapsulation used for this L2VPN bridge domain segment.";
    }
    leaf state {
      type l2vpn-ios-xe-oper:l2vpn-xconnect-segment-state;
      description
        "Operational state of the bridge domain in the L2VPN xconnect segment (e.g., up, down, or other status).";
    }
    leaf state-in-l2vpn-service {
      type l2vpn-ios-xe-oper:l2vpn-xconnect-state;
      description
        "Operational state of the bridge domain as it pertains to the overall L2VPN service (e.g., active, standby, or failed).";
    }
    leaf priority {
      type uint32;
      description
        "Specifies the priority value assigned to the bridge domain for L2VPN operations, which may influence forwarding decisions or failover behavior.";
    }
  }

  grouping forwarder {
    description
      "L2VPN forwarder info";
    choice fwd-type-choice {
      description
        "Type of the L2VPN forwarder";
      case l2vpn-fwd-type-ac {
        container attachment-circuit {
          description
            "L2VPN attachment-circuit information";
          uses l2vpn-ios-xe-oper:fwd-info-ac;
        }
      }
      case l2vpn-fwd-type-pw {
        container pseudowire {
          description
            "L2VPN pseudo-wire information";
          uses l2vpn-ios-xe-oper:fwd-info-pw;
        }
      }
      case l2vpn-fwd-type-vfi {
        container vfi {
          description
            "Contains information related to the Virtual Private LAN Service (VPLS) Virtual Forwarding Instance (VFI) for L2VPN.";
          uses l2vpn-ios-xe-oper:fwd-info-vfi;
        }
      }
      case l2vpn-fwd-type-bd {
        container bridge-domain {
          description
            "L2VPN bridge domain information";
          uses l2vpn-ios-xe-oper:fwd-info-bd;
        }
      }
    }
  }

  grouping l2vpn-xconnect-key {
    description
      "L2VPN xconnect key";
    leaf peer-address {
      type inet:ipv4-address;
      description
        "L2VPN xconnect peer ipv4 address";
    }
    leaf vcid {
      type uint32;
      description
        "L2VPN xconnect virtual circuit id";
    }
  }

  grouping standby-segments {
    description
      "L2VPN xconnect standby segments";
    container segment1 {
      description
        "Represents the first standby segment for L2VPN xconnect, used as a backup path in case the primary segment fails.";
      uses l2vpn-ios-xe-oper:forwarder;
    }
    container segment2 {
      description
        "L2VPN xconnect standby segment 2";
      uses l2vpn-ios-xe-oper:forwarder;
    }
  }

  grouping l2vpn-xconnect-data {
    description
      "L2VPN xconnect data";
    leaf xconnect-name {
      type string;
      description
        "L2VPN xconnect service name";
    }
    leaf service-type {
      type l2vpn-ios-xe-oper:l2vpn-service-type;
      description
        "L2VPN xconnect service type";
    }
    leaf xconnect-state {
      type l2vpn-ios-xe-oper:l2vpn-xconnect-state;
      description
        "L2VPN xconnect state";
    }
    leaf description {
      type string;
      description
        "L2VPN xconnect description";
    }
    container segment1 {
      description
        "First segment of the L2VPN xconnect, representing one endpoint of the point-to-point connection";
      uses l2vpn-ios-xe-oper:forwarder;
    }
    container segment2 {
      description
        "Represents the second segment of the L2VPN xconnect, which may correspond to the remote or secondary connection endpoint in a point-to-point Layer 2 VPN service.";
      uses l2vpn-ios-xe-oper:forwarder;
    }
    list standby {
      description
        "A List of L2VPN xconnect standby segments if present";
      uses l2vpn-ios-xe-oper:standby-segments;
    }
  }

  grouping l2vpn-services {
    description
      "Container for operational data of configured Layer 2 VPN (L2VPN) services on the device.";
    list l2vpn-xconnect {
      key "peer-address vcid";
      description
        "List of Layer 2 VPN (L2VPN) point-to-point cross-connect (xconnect) services and their operational data.";
      uses l2vpn-ios-xe-oper:l2vpn-xconnect-key;
      uses l2vpn-ios-xe-oper:l2vpn-xconnect-data;
    }
  }

  grouping l2vpn-vc-next-hop {
    description
      "L2VPN Next hop info";
    choice next-hop-type-choice {
      description
        "Type of the Next hop";
      case l2vpn-vc-no-nh {
        leaf no-nh {
          type empty;
          description
            "L2VPN VC no next hop";
        }
      }
      case l2vpn-vc-nh-p2p {
        leaf p2p {
          type empty;
          description
            "L2VPN VC next hop P2P";
        }
      }
      case l2vpn-vc-nh-ipv4-addr {
        leaf nh-ipv4-addr {
          type inet:ipv4-address;
          description
            "L2VPN VC next hop IPV4 address";
        }
      }
      case l2vpn-vc-nh-ipv6-addr {
        leaf nh-ipv6-addr {
          type inet:ipv6-address;
          description
            "L2VPN VC next hop IPV6 address";
        }
      }
    }
  }

  grouping l2vpn-vc-pref-path {
    description
      "L2VPN VC preferred path information";
    choice pref-path-type-choice {
      description
        "Type of the preferred path";
      case l2vpn-pref-not-conf {
        leaf not-conf {
          type empty;
          description
            "L2VPN VC preferred path not configured";
        }
      }
      case l2vpn-pref-no-route {
        leaf no-route {
          type empty;
          description
            "L2VPN VC no route to preferred path";
        }
      }
      case l2vpn-pref-out-if {
        leaf out-if {
          type string;
          description
            "L2VPN VC output tunnel interface";
        }
      }
      case l2vpn-pref-next-hop-addr {
        leaf nh-addr {
          type inet:ipv4-address;
          description
            "L2VPN VC next hop IPV4 address";
        }
      }
    }
  }

  grouping l2vpn-atom-bgp-info {
    description
      "L2VPN ATOM BGP signaling info";
    leaf local-ve-id {
      type uint32;
      description
        "Local VE identifier";
    }
    leaf remote-ve-id {
      type uint32;
      description
        "Remote VE identifier";
    }
  }

  grouping l2vpn-atom-ldp-info {
    description
      "L2VPN ATOM LDP signaling info";
    leaf tgt-hello-src {
      type inet:ipv4-address;
      description
        "IP address used as the source for LDP targeted hello messages.";
    }
    leaf tgt-hello-dest {
      type inet:ipv4-address;
      description
        "IP address used as the destination for LDP targeted hello messages.";
    }
    leaf status {
      type l2vpn-ios-xe-oper:l2vpn-atom-ldp-status;
      description
        "Status of the LDP";
    }
    leaf gr-config {
      type l2vpn-ios-xe-oper:l2vpn-feat-conf;
      description
        "Indicates the configuration state of the Graceful Restart (GR) feature for LDP-based L2VPN pseudowire signaling.";
    }
    leaf gr {
      type l2vpn-ios-xe-oper:l2vpn-feat-en;
      description
        "Indicates whether the Graceful Restart (GR) feature is enabled for LDP-based L2VPN pseudowire signaling.";
    }
    leaf nsr-config {
      type l2vpn-ios-xe-oper:l2vpn-feat-conf;
      description
        "Indicates the configuration state of the Non-Stop Routing (NSR) feature for LDP-based L2VPN pseudowire signaling.";
    }
    leaf nsr {
      type l2vpn-ios-xe-oper:l2vpn-feat-en;
      description
        "Indicates whether the Non-Stop Routing (NSR) feature is enabled for LDP-based L2VPN pseudowire signaling.";
    }
    leaf fec-type {
      type l2vpn-ios-xe-oper:l2vpn-atom-fec-type;
      description
        "Specifies the type of Forwarding Equivalence Class (FEC) used for LDP-based L2VPN pseudowire signaling.";
    }
  }

  grouping l2vpn-atom-vpws-info {
    description
      "L2VPN ATOM VPWS information";
    leaf assoc-member-if {
      type string;
      description
        "Associated member interface name";
    }
    leaf group-name {
      type string;
      description
        "Name of the group to which this L2VPN VPWS service belongs.";
    }
    leaf status {
      type l2vpn-ios-xe-oper:l2vpn-service-state;
      description
        "Status of service";
    }
    leaf iw-type {
      type l2vpn-ios-xe-oper:l2vpn-iw-type;
      description
        "Specifies the type of interworking configured for this L2VPN VPWS service (e.g., Ethernet, IP).";
    }
  }

  grouping l2vpn-atom-vpls-info {
    description
      "L2VPN ATOM VPLS information";
    leaf bd-id {
      type uint32;
      description
        "Identifier of the bridge domain associated with this VPLS service instance.";
    }
  }

  grouping l2vpn-service-info {
    description
      "L2VPN service information";
    leaf service-name {
      type string;
      description
        "Specifies the configured name of the L2VPN service associated with this pseudowire.";
    }
    leaf service-id {
      type uint32;
      description
        "Unique identifier for the L2VPN service associated with this pseudowire.";
    }
    choice atom-service-type-choice {
      description
        "Type of L2VPN ATOM service";
      case l2vpn-service-vpws {
        container vpws-info {
          description
            "L2VPN VPWS service information";
          uses l2vpn-ios-xe-oper:l2vpn-atom-vpws-info;
        }
      }
      case l2vpn-service-vpls {
        container vpls-info {
          description
            "L2VPN VPLS service information";
          uses l2vpn-ios-xe-oper:l2vpn-atom-vpls-info;
        }
      }
    }
  }

  grouping signalling-proto-info {
    description
      "L2VPN signalling protocol info";
    leaf ldp-route-watch {
      type l2vpn-ios-xe-oper:l2vpn-feat-en;
      description
        "LDP route watch status";
    }
    leaf label-state {
      type l2vpn-ios-xe-oper:l2vpn-atom-mgr-state;
      description
        "Operational status of the MPLS label assigned to this pseudowire.";
    }
    leaf fsm-state {
      type l2vpn-ios-xe-oper:l2vpn-atom-mgr-fsm-state;
      description
        "Current state of the finite state machine (FSM) managing the pseudowire signaling process.";
    }
    leaf local-dp-status-rcv {
      type l2vpn-ios-xe-oper:l2vpn-circuit-status;
      description
        "Local dataplane status received";
    }
    leaf bfd-dp-status-rcv {
      type l2vpn-ios-xe-oper:l2vpn-circuit-status;
      description
        "BFD dataplane status received";
    }
    leaf bfd-dp-pm-status-rcv {
      type l2vpn-ios-xe-oper:l2vpn-circuit-status;
      description
        "BFD peer monitor status received";
    }
    leaf status-rcv-ac {
      type l2vpn-ios-xe-oper:l2vpn-circuit-status;
      description
        "Status received from access circuit";
    }
    leaf status-sent-ac {
      type l2vpn-ios-xe-oper:l2vpn-circuit-status;
      description
        "Status sent to access circuit";
    }
    leaf status-rcv-pw {
      type l2vpn-ios-xe-oper:l2vpn-circuit-status;
      description
        "Status received from pseudowire interface";
    }
    leaf status-sent-nw-peer {
      type l2vpn-ios-xe-oper:l2vpn-circuit-status;
      description
        "Status sent to network peer";
    }
    leaf status-rcv-nw-peer {
      type l2vpn-ios-xe-oper:l2vpn-circuit-status;
      description
        "Status received from network peer";
    }
    leaf adj-status-remote-peer {
      type l2vpn-ios-xe-oper:l2vpn-circuit-status;
      description
        "Adjacency status of remote peer";
    }
    choice signalling-choice {
      description
        "Type of signalling for L2VPN negotiations";
      case l2vpn-atom-vc-proto-ldp {
        container ldp-info {
          description
            "L2VPN LDP signalling information";
          uses l2vpn-ios-xe-oper:l2vpn-atom-ldp-info;
        }
      }
      case l2vpn-atom-vc-proto-bgp {
        container bgp-info {
          description
            "L2VPN BGP signalling information";
          uses l2vpn-ios-xe-oper:l2vpn-atom-bgp-info;
        }
      }
    }
  }

  grouping l2vpn-binding-params {
    description
      "L2VPN binding parameters";
    leaf label {
      type uint32;
      description
        "MPLS label value assigned to the virtual circuit (VC) for the pseudowire.";
    }
    leaf group-id {
      type uint32;
      description
        "Identifier for the group to which this pseudowire belongs, used for grouping related virtual circuits in L2VPN.";
    }
    leaf if-name {
      type string;
      description
        "Name of the interface associated with the L2VPN virtual circuit.";
    }
    leaf mtu {
      type uint16;
      description
        "Maximum Transmission Unit (MTU) configured for the pseudowire binding.";
    }
    leaf control-word {
      type l2vpn-ios-xe-oper:l2vpn-atom-pw-cw;
      description
        "Indicates the control word configuration or status for the pseudowire binding.";
    }
    leaf cw-auto-sense {
      type l2vpn-ios-xe-oper:l2vpn-cw-auto-sense;
      description
        "Indicates whether automatic detection of control word usage is enabled for the remote pseudowire binding.";
    }
    leaf vc-type {
      type l2vpn-ios-xe-oper:l2vpn-atom-vc-type;
      description
        "Specifies the type of virtual circuit (VC) used for the pseudowire binding, such as Ethernet, Frame Relay, or ATM.";
    }
    leaf vccv-cv-type {
      type l2vpn-ios-xe-oper:l2vpn-vccv-cv-type-flags;
      description
        "Flag indicating the type of Connectivity Verification (CV) supported for Virtual Circuit Connectivity Verification (VCCV) on this pseudowire.";
    }
    leaf vccv-cc-type {
      type l2vpn-ios-xe-oper:l2vpn-vccv-cc-type-flags;
      description
        "Indicates the type of Control Channel (CC) used for Virtual Circuit Connectivity Verification (VCCV) on the pseudowire binding.";
    }
    leaf status-tlv {
      type l2vpn-ios-xe-oper:l2vpn-vc-status-tlv;
      description
        "Specifies the configuration of the Status Type-Length-Value (TLV) used for signaling the status of the pseudowire in L2VPN.";
    }
  }

  grouping l2vpn-pw-data-params {
    description
      "L2vpn PW binding data parameters";
    container local-binding {
      description
        "Binding details of the local node";
      uses l2vpn-ios-xe-oper:l2vpn-binding-params;
    }
    container remote-binding {
      description
        "Binding details of the remote node";
      uses l2vpn-ios-xe-oper:l2vpn-binding-params;
    }
  }

  grouping l2vpn-atom-dataplane-params {
    description
      "VC statistics data";
    leaf segment-id {
      type uint32;
      description
        "Identifier for the Segment Switching Module (SSM) segment associated with the L2VPN dataplane. Used to uniquely identify the dataplane segment for the virtual circuit.";
    }
    leaf switch-id {
      type uint32;
      description
        "Identifier for the Segment Switching Module (SSM) switch associated with the L2VPN dataplane. Used to uniquely identify the switch instance for the virtual circuit.";
    }
    leaf pwid {
      type uint32;
      description
        "Pseudowire (PW) identifier used to uniquely identify the L2VPN pseudowire in the dataplane.";
    }
  }

  grouping l2vpn-atom-vc-statistics {
    description
      "L2vpn dataplane parameters";
    leaf rx-pkts {
      type uint64;
      description
        "Number of packets received (RX) on the L2VPN virtual circuit.";
    }
    leaf rx-bytes {
      type uint64;
      description
        "Number of bytes received (RX) on the L2VPN virtual circuit.";
    }
    leaf rx-drops {
      type uint64;
      description
        "Number of received packets dropped on the virtual circuit (VC) due to errors or resource limitations.";
    }
    leaf seq-err-pkts {
      type uint64;
      description
        "RX sequential error packets";
    }
    leaf tx-pkts {
      type uint64;
      description
        "Total number of packets transmitted on the virtual circuit (VC).";
    }
    leaf tx-bytes {
      type uint64;
      description
        "Total number of bytes transmitted on the virtual circuit (VC).";
    }
    leaf tx-drops {
      type uint64;
      description
        "Number of transmitted packets dropped on the virtual circuit (VC) due to errors or resource limitations.";
    }
    leaf mwc-tx {
      type uint64;
      description
        "MAC withdraw TX counter";
    }
    leaf mwc-rx {
      type uint64;
      description
        "MAC withdraw RX counter";
    }
  }

  grouping l2vpn-atom-vc-data {
    description
      "L2VPN L2 atom VC data";
    leaf local-if-name {
      type string;
      description
        "Local Interface name";
    }
    leaf circuit-type {
      type l2vpn-ios-xe-oper:l2vpn-ac-circuit-type;
      description
        "Specifies the type of attachment circuit used in the L2VPN virtual circuit (e.g., Ethernet, VLAN).";
    }
    leaf if-name {
      type string;
      description
        "Name of the interface associated with the remote pseudowire binding.";
    }
    leaf service-type {
      type l2vpn-ios-xe-oper:l2vpn-atom-service-type;
      description
        "Specifies the type of L2VPN service (e.g., Ethernet, ATM, Frame Relay) associated with this virtual circuit.";
    }
    leaf service-name {
      type string;
      description
        "Name of the L2VPN service associated with this virtual circuit, used for identification and management purposes.";
    }
    leaf vc-status {
      type l2vpn-ios-xe-oper:l2vpn-vc-status;
      description
        "Indicates the current operational status of the L2VPN virtual circuit (VC), such as up, down, or administratively down.";
    }
    leaf create-time {
      type yang:date-and-time;
      description
        "L2VPN VC Create time";
    }
    leaf last-status-change {
      type yang:date-and-time;
      description
        "L2VPN VC last status change";
    }
    leaf last-fsm-change {
      type yang:date-and-time;
      description
        "L2VPN VC last FSM change";
    }
    leaf last-error {
      type l2vpn-ios-xe-oper:l2vpn-atom-mgr-vc-last-error;
      description
        "L2VPN VC last error";
    }
    leaf output-if {
      type string;
      description
        "L2VPN VC output interface";
    }
    leaf-list label-stack {
      type uint32;
      ordered-by user;
      description
        "L2VPN imposed label stack";
    }
    container preferred-path {
      description
        "L2VPN VC preferred path";
      uses l2vpn-ios-xe-oper:l2vpn-vc-pref-path;
    }
    leaf default-path {
      type l2vpn-ios-xe-oper:l2vpn-def-path-state;
      description
        "Indicates the default path state for the L2VPN Virtual Circuit (VC), used when no preferred path is configured or available.";
    }
    container next-hop {
      description
        "Specifies the next hop information for the L2VPN Virtual Circuit (VC), used to determine the forwarding path.";
      uses l2vpn-ios-xe-oper:l2vpn-vc-next-hop;
    }
    leaf lb-mode {
      type l2vpn-ios-xe-oper:l2vpn-pw-lb-mode;
      description
        "Specifies the load-balancing mode used for L2VPN pseudowires, determining how traffic is distributed across available paths.";
    }
    leaf lb-flow-class {
      type l2vpn-ios-xe-oper:l2vpn-pw-lb-fc;
      description
        "Indicates the flow classification mode used for load balancing in L2VPN pseudowires, specifying how traffic flows are identified for distribution.";
    }
    container service-info {
      description
        "Contains detailed information about the L2VPN service associated with the pseudowire, including service type, identifiers, and configuration details.";
      uses l2vpn-ios-xe-oper:l2vpn-service-info;
    }
    leaf signalling-proto {
      type l2vpn-ios-xe-oper:l2vpn-atom-vc-protocol-type;
      description
        "Signalling protocol type";
    }
    container signalling-info {
      description
        "Pseudowire signalling information";
      uses l2vpn-ios-xe-oper:signalling-proto-info;
    }
    leaf rx-sequence {
      type l2vpn-ios-xe-oper:l2vpn-pw-sequence;
      description
        "Indicates the receive-side sequencing configuration or status for L2VPN pseudowire data packets.";
    }
    leaf tx-sequence {
      type l2vpn-ios-xe-oper:l2vpn-pw-sequence;
      description
        "Indicates the transmit-side sequencing configuration or status for L2VPN pseudowire data packets.";
    }
    container pw-binding-data {
      description
        "Contains operational data related to the binding of a pseudowire, including parameters and state information relevant to the L2VPN service.";
      uses l2vpn-ios-xe-oper:l2vpn-pw-data-params;
    }
    container dataplane-data {
      description
        "Contains operational dataplane parameters and identifiers for the L2VPN atom virtual circuit, such as segment ID, switch ID, and pseudowire ID.";
      uses l2vpn-ios-xe-oper:l2vpn-atom-dataplane-params;
    }
    container vc-stats {
      description
        "Contains statistics for the virtual circuit (VC) in the L2VPN atom, including packet and byte counters for received and transmitted traffic.";
      uses l2vpn-ios-xe-oper:l2vpn-atom-vc-statistics;
    }
  }

  grouping l2vpn-atom-key {
    description
      "L2VPN atom vc table key";
    leaf peer-address {
      type inet:ipv4-address;
      description
        "L2VPN vc peer ipv4 address";
    }
    leaf vcid {
      type uint32;
      description
        "L2VPN virtual circuit id";
    }
  }

  container l2vpn-oper-data {
    config false;
    description
      "Container for operational data related to Layer 2 Virtual Private Network (L2VPN) services, including status and statistics.";
    container l2vpn-services {
      presence "l2vpn-services";
      description
        "Container for operational data of configured Layer 2 VPN (L2VPN) services on the device.";
      uses l2vpn-ios-xe-oper:l2vpn-services;
    }
    list l2vpn-atom-vc-info {
      key "peer-address vcid";
      description
        "L2VPN atom VC Info";
      uses l2vpn-ios-xe-oper:l2vpn-atom-key;
      uses l2vpn-ios-xe-oper:l2vpn-atom-vc-data;
    }
  }
}
