          "L2VPN attachment circuit type Circuit Emulation Service over Packet Switched Network (CES PSN) Channel Associated Signaling (CAS).";
      }
      enum ac-circuit-atm-vc-unknown {
        value 21;
        description
          "L2VPN attachment circuit type Asynchronous Transfer Mode (ATM) Virtual Circuit (VC) unknown.";
      }
      enum ac-circuit-atm-vp-unknown {
        value 22;
        description
          "L2VPN attachment circuit type Asynchronous Transfer Mode (ATM) Virtual Path (VP) unknown.";
      }
      enum ac-circuit-atom {
        value 23;
