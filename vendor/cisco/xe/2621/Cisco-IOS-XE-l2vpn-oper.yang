          "L2VPN attachment circuit type IP.";
      }
      enum ac-circuit-vfi {
        value 13;
        description
          "L2VPN attachment circuit type Virtual Forwarding Instance (VFI).";
      }
      enum ac-circuit-satop-e1 {
        value 15;
        description
