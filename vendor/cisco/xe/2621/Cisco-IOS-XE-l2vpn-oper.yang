      enum l2vpn-fwd-type-ac {
        value 1;
        description
          "Attachment circuit (AC).";
      }
      enum l2vpn-fwd-type-pw {
        value 2;
        description
          "L2VPN forwarder type pseudowire (PW).";
      }
      enum l2vpn-fwd-type-vfi {
        value 3;
        description
          "L2VPN forwarder type Virtual Forwarding Instance (VFI).";
      }
      enum l2vpn-fwd-type-bd {
        value 4;
        description
          "L2VPN forwarder type bridge domain (BD).";
      }
    }
    description
      "L2VPN forwarder type.";
  }

  typedef l2vpn-vc-status {
