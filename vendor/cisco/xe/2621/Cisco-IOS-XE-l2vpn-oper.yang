      }
      enum ac-circuit-pw-udp {
        value 26;
        description
          "L2VPN attachment circuit type Pseudowire (PW) over UDP.";
      }
      enum ac-circuit-dossis {
        value 27;
        description
          "L2VPN attachment circuit type Data Over Cable Service Interface Specification (DOCSIS).";
      }
      enum ac-circuit-dossis-vlan {
        value 28;
        description
          "L2VPN attachment circuit type Data Over Cable Service Interface Specification (DOCSIS) VLAN.";
      }
    }
    description
      "L2VPN attachment circuit type.";
  }

  typedef l2vpn-pw-encap-type {
