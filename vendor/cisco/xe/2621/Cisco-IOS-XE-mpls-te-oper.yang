  }

  typedef te-lm-link-bcid-type {
    type enumeration {
      enum lm-link-type-mam {
        value 0;
        description
          "Link type Maximum allocation model";
      }
      enum lm-link-type-rdm {
        value 1;
        description
          "Link type R-D-M";
      }
    }
    description
      "TE link management type";
  }

  grouping te-slsp-ero-hop {
    description
      "TE sub LSP explicit route object hop";
    leaf ero-type {
      type mpls-te-ios-xe-oper:te-slsp-ero-type;
      description
        "Indicates whether the Explicit Route Object (ERO) hop is a strict or loose hop in the path of the Traffic Engineering (TE) sub Label Switched Path (LSP).";
    }
    leaf ero-address {
      type inet:ip-address;
      description
        "IP address of the Explicit Route Object (ERO) hop in the path of the Traffic Engineering (TE) sub Label Switched Path (LSP).";
    }
  }

  grouping te-slsp-hop {
    description
      "TE sub LSP hop";
    leaf slsp-hop-interface {
      type string;
      description
        "Name of the interface used as the ingress or egress hop for the sub Label Switched Path (LSP).";
    }
    leaf slsp-hop-interface-id {
      type uint32;
      description
        "Identifier for the interface used as the ingress or egress hop for the sub Label Switched Path (LSP).";
    }
    leaf slsp-hop-label {
      type uint32;
      description
        "MPLS label assigned to the ingress or egress hop of the sub Label Switched Path (LSP).";
    }
  }

  grouping te-sub-lsp-key {
    description
      "TE sub LSP key";
    leaf slsp-source-address {
      type inet:ip-address;
      description
        "Specifies the source IP address for the sub Label Switched Path (sub-LSP).";
    }
    leaf slsp-destination-address {
      type inet:ip-address;
      description
        "Specifies the destination IP address for the sub Label Switched Path (sub-LSP) associated with the TE link.";
    }
    leaf slsp-tunnel-id {
      type uint16;
      description
        "Identifier for the tunnel associated with the sub Label Switched Path (sub-LSP) for the TE link.";
    }
    leaf slsp-lsp-id {
      type uint16;
      description
        "Unique identifier for the sub Label Switched Path (sub-LSP) associated with the TE link.";
    }
    leaf slsp-extended-ip-address {
      type inet:ip-address;
      description
        "Extended IP address associated with the sub Label Switched Path (sub-LSP)";
    }
    leaf slsp-p2mp-id {
      type uint32;
      description
        "Identifier for the point-to-multipoint (P2MP) sub-LSP.";
    }
    leaf slsp-p2mp-grp-id {
      type uint32;
      description
        "Group identifier for the point-to-multipoint (P2MP) sub-LSP.";
    }
    leaf slsp-p2mp-grp-origin {
      type uint32;
      description
        "Specifies the origin identifier for the point-to-multipoint (P2MP) group associated with this sub-LSP.";
    }
  }

  grouping te-sub-lsp {
    description
      "TE sub LSP";
    leaf slsp-role {
      type mpls-te-ios-xe-oper:te-slsp-role;
      description
        "Indicates the role of the sub Label Switched Path (LSP) within the MPLS TE tunnel, such as head, mid, or tail.";
    }
    leaf slsp-state {
      type mpls-te-ios-xe-oper:te-slsp-state;
      description
        "Current operational state of the sub Label Switched Path (LSP), such as connected or disconnected.";
    }
    container slsp-ingress-hop {
      description
        "Information about the ingress hop for the sub Label Switched Path (LSP)";
      uses mpls-te-ios-xe-oper:te-slsp-hop;
    }
    container slsp-egress-hop {
      description
        "Information about the egress hop for the sub Label Switched Path (LSP)";
      uses mpls-te-ios-xe-oper:te-slsp-hop;
    }
    leaf slsp-frr-state {
      type mpls-te-ios-xe-oper:te-slsp-frr-state;
      description
        "Indicates the Fast Reroute (FRR) state for the Traffic Engineering (TE) sub Label Switched Path (LSP), showing whether FRR is enabled, ready, active, or not in use.";
    }
    leaf slsp-frr-backup-tunnel-id {
      type uint16;
      description
        "Identifier of the backup tunnel used for Fast Reroute (FRR) protection of the Traffic Engineering (TE) sub Label Switched Path (LSP).";
    }
    leaf slsp-frr-backup-label {
      type uint32;
      description
        "MPLS label assigned to the backup tunnel used for Fast Reroute (FRR) protection of the Traffic Engineering (TE) sub Label Switched Path (LSP).";
    }
    leaf slsp-frr-mergepoint-label {
      type uint32;
      description
        "MPLS label used at the merge point where the Fast Reroute (FRR) backup path rejoins the primary path for the Traffic Engineering (TE) sub Label Switched Path (LSP).";
    }
    leaf slsp-bandwidth-kbps {
      type uint32;
      units "kbps";
      description
        "Bandwidth allocated to the Traffic Engineering (TE) sub Label Switched Path (LSP), measured in kilobits per second (kbps).";
    }
    list ero-hop {
      description
        "List of hops in the Explicit Route Object (ERO); each entry defines a specific node or address along the path of the Traffic Engineering (TE) sub Label Switched Path (LSP).";
      uses mpls-te-ios-xe-oper:te-slsp-ero-hop;
    }
  }

  grouping te-he-tunnel-counters {
    description
      "TE head-end tunnel counters";
    leaf path-err-no-route {
      type uint32;
      description
        "TE path error no route";
    }
    leaf path-err-bad-label {
      type uint32;
      description
        "TE path error bad label";
    }
    leaf path-err-adminstrative {
      type uint32;
      description
        "Indicates the number of path errors caused by administrative actions, such as manual shutdowns or configuration changes, in the TE tunnel.";
    }
    leaf path-err-no-bandwidth {
      type uint32;
      description
        "TE path error no bandwidth";
    }
    leaf path-err-bad-strict-node {
      type uint32;
      description
        "TE path error bad strict node";
    }
    leaf path-err-bad-loose-node {
      type uint32;
      description
        "TE path error bad loose node";
    }
    leaf path-err-rro-loop {
      type uint32;
      description
        "Indicates the number of path errors due to a loop detected in the Record Route Object (RRO) during TE tunnel path computation.";
    }
    leaf path-err-bad-ero {
      type uint32;
      description
        "TE path error bad explicit route object";
    }
    leaf path-change {
      type uint32;
      description
        "Indicates the number of times the TE tunnel path has changed due to re-optimization, failure, or other events.";
    }
    leaf state-change {
      type uint32;
      description
        "Indicates the number of times the operational state of the TE tunnel has changed.";
    }
    leaf admin-down {
      type uint32;
      description
        "Indicates the number of times the TE tunnel has been administratively shut down.";
    }
    leaf oper-down {
      type uint32;
      description
        "Indicates the number of times the TE tunnel has transitioned to an operationally down state.";
    }
    leaf missing-explicit-path {
      type uint32;
      description
        "Number of times an explicit path was missing for the MPLS TE tunnel.";
    }
    leaf no-path {
      type uint32;
      description
        "Number of times no path was found for the MPLS TE tunnel.";
    }
    leaf path-lookups {
      type uint32;
      description
        "Number of path lookup operations performed for the MPLS TE tunnel.";
    }
    leaf invalid-path {
      type uint32;
      description
        "Number of times an invalid path was encountered for the MPLS TE tunnel.";
    }
    leaf protect-path-opt-cfg-err {
      type uint32;
      description
        "Protection path option config error";
    }
    leaf protection-path-opt-error {
      type uint32;
      description
        "Protection path option error";
    }
    leaf sig-timeout {
      type uint32;
      description
        "Signal timeout";
    }
    leaf sig-bad-path {
      type uint32;
      description
        "Signal bad path";
    }
    leaf sig-abort {
      type uint32;
      description
        "Signal abort";
    }
    leaf sig-ok {
      type uint32;
      description
        "Signal OK";
    }
    leaf frr-activated {
      type uint32;
      description
        "Fast re-route activated";
    }
    leaf wrap-activated {
      type uint32;
      description
        "Number of times wrap protection was activated for this tunnel.";
    }
    leaf loose-path-reopt {
      type uint32;
      description
        "Number of times loose path re-optimization was performed for this tunnel.";
    }
    leaf p2mp-remerge {
      type uint32;
      description
        "Point to multi-point re-merge";
    }
    leaf other {
      type uint32;
      description
        "Counter for miscellaneous or unclassified tunnel events.";
    }
    leaf autobw-adjustment {
      type uint32;
      description
        "Auto bandwidth adjustment";
    }
    leaf autobw-overflow {
      type uint32;
      description
        "Auto bandwidth overflow";
    }
    leaf sso-recover-attempts {
      type uint32;
      description
        "SSO recover attempts";
    }
    leaf sso-recover-success {
      type uint32;
      description
        "SSO recover success";
    }
    leaf sso-recover-failures {
      type uint32;
      description
        "SSO recover failures";
    }
  }

  grouping te-he-tunnel-history {
    description
      "TE head-end tunnel history";
    leaf prev-lsp-instance {
      type int32;
      description
        "Identifier of the previous Label Switched Path (LSP) instance associated with this MPLS TE tunnel.";
    }
    leaf prev-lsp-remove-reason {
      type mpls-te-ios-xe-oper:te-he-lsp-fail-reason;
      description
        "Specifies the reason why the previous Label Switched Path (LSP) instance was removed from the MPLS TE tunnel.";
    }
    leaf elect-reason {
      type mpls-te-ios-xe-oper:te-he-lsp-elect-reason;
      description
        "Indicates the reason for the election of the current Label Switched Path (LSP) instance for the MPLS TE tunnel.";
    }
  }

  grouping te-he-tunnel-bundle {
    description
      "TE head-end tunnel bundle";
    leaf bundle-name {
      type string;
      description
        "Specifies the name assigned to the MPLS TE tunnel bundle, which groups multiple tunnels for operational or configuration purposes.";
    }
    leaf exp-bits {
      type uint16;
      description
        "Specifies the value of the experimental (EXP) bits used for MPLS TE tunnel bundle traffic classification or QoS marking.";
    }
    leaf nonexp-bits {
      type uint16;
      description
        "Specifies the value of the non-experimental bits in the MPLS TE tunnel bundle, used for traffic that does not require special QoS marking.";
    }
    leaf-list member-id {
      type uint16;
      ordered-by user;
      description
        "TE bundle member tunnel ID";
    }
  }

  grouping te-he-tunnel-hop {
    description
      "TE head-end tunnel hop";
    leaf hop-type {
      type mpls-te-ios-xe-oper:te-he-tunnel-hop-type;
      description
        "TE tunnel hop type";
    }
    leaf next-ip {
      type inet:ip-address;
      description
        "TE tunnel next hop IP address";
    }
    leaf local-ip {
      type inet:ip-address;
      description
        "TE tunnel hop local IP address";
    }
    leaf label {
      type uint32;
      description
        "TE tunnel hop label";
    }
  }

  grouping te-he-tunnel-slsp {
    description
      "TE head-end tunnel sub LSP";
    container slsp-key {
      description
        "TE tunnel sub LSP key";
      uses mpls-te-ios-xe-oper:te-sub-lsp-key;
    }
    leaf up-timestamp {
      type yang:date-and-time;
      description
        "TE tunnel sub LSP up-time";
    }
    leaf path-option-idx {
      type uint32;
      description
        "Index of the path option used by this TE tunnel sub-LSP.";
    }
    list hop {
      description
        "TE tunnel sub LSP hops";
      uses mpls-te-ios-xe-oper:te-he-tunnel-hop;
    }
  }

  grouping te-he-tunnel-lsp {
    description
      "TE head-end tunnel LSP";
    leaf tunnel-lsp-state {
      type mpls-te-ios-xe-oper:te-he-lsp-state;
      description
        "Current operational state of the Label Switched Path (LSP) for the MPLS TE tunnel.";
    }
    leaf tunnel-lsp-mode {
      type mpls-te-ios-xe-oper:te-he-lsp-mode;
      description
        "Indicates the operational mode of the Label Switched Path (LSP) for the MPLS TE tunnel, such as working, protect, or re-optimization.";
    }
    leaf tunnel-lsp-fail-reason {
      type mpls-te-ios-xe-oper:te-he-lsp-fail-reason;
      description
        "Specifies the reason for the most recent failure of the Label Switched Path (LSP) associated with the MPLS TE tunnel.";
    }
    leaf tunnel-lsp-uptime {
      type yang:date-and-time;
      description
        "TE tunnel LSP up-time";
    }
    list tunnel-lsp-slsps {
      description
        "Lists the sub-Label Switched Paths (sub-LSPs) associated with this TE tunnel LSP; each entry represents one sub-LSP.";
      uses mpls-te-ios-xe-oper:te-he-tunnel-slsp;
    }
  }

  grouping te-he-tunnel-auto-bw-info {
    description
      "TE head-end tunnel auto bandwidth information";
    leaf auto-bw-kbps-last {
      type uint32;
      description
        "TE auto bandwidth KBPS last";
    }
    leaf auto-bw-kbps-highest {
      type uint32;
      description
        "TE auto bandwidth KBPS highest";
    }
    leaf auto-bw-overflow-cnt {
      type uint32;
      description
        "TE auto bandwidth overflow count";
    }
  }

  grouping te-he-tunnel {
    description
      "TE head-end tunnel";
    leaf tunnel-id {
      type uint16;
      description
        "TE head-end tunnel ID";
    }
    leaf tunnel-name {
      type string;
      description
        "Specifies the user-configured name for the MPLS TE head-end tunnel.";
    }
    leaf tunnel-type {
      type mpls-te-ios-xe-oper:te-he-tunnel-type;
      description
        "Indicates the type of MPLS TE tunnel, such as static, auto-backup, auto-mesh, or API-created.";
    }
    leaf tunnel-mode-type {
      type mpls-te-ios-xe-oper:te-he-tunnel-mode-type;
      description
        "Specifies the operational mode of the MPLS TE tunnel, such as point-to-point (P2P), point-to-multipoint (P2MP), or multi-LSP.";
    }
    leaf dest-ip {
      type inet:ip-address;
      description
        "TE tunnel destination IP";
    }
    leaf admin-state {
      type mpls-te-ios-xe-oper:te-tunnel-admin-state;
      description
        "TE tunnel admin status";
    }
    leaf oper-state {
      type mpls-te-ios-xe-oper:te-tunnel-oper-state;
      description
        "TE tunnel oper status";
    }
    leaf path {
      type mpls-te-ios-xe-oper:te-tunnel-path;
      description
        "Indicates the operational path status of the MPLS TE tunnel, such as valid, not valid, or pending.";
    }
    leaf signalling {
      type mpls-te-ios-xe-oper:te-tunnel-signalling;
      description
        "Indicates the current signalling state of the MPLS TE tunnel, such as connected, down, or waiting for BFD.";
    }
    leaf tunnel-inst {
      type uint32;
      description
        "Number of TE tunnel instances";
    }
    container tunnel-bundle {
      description
        "Contains information about the MPLS TE tunnel bundle, including bundle name, member tunnel IDs, and related attributes.";
      uses mpls-te-ios-xe-oper:te-he-tunnel-bundle;
    }
    leaf create-time {
      type yang:date-and-time;
      description
        "TE tunnel create time";
    }
    leaf path-chg-time {
      type yang:date-and-time;
      description
        "TE tunnel path change time";
    }
    leaf tunnel-state {
      type mpls-te-ios-xe-oper:te-he-tunnel-state;
      description
        "Indicates the current operational state of the MPLS TE tunnel, such as up, down, or administratively down.";
    }
    container tunnel-counters {
      description
        "Contains various counters related to MPLS TE tunnel operations, such as error counts, state changes, and bandwidth adjustments.";
      uses mpls-te-ios-xe-oper:te-he-tunnel-counters;
    }
    leaf last-fail-reason {
      type mpls-te-ios-xe-oper:te-he-tunnel-fail-reason;
      description
        "Indicates the most recent failure reason for the MPLS TE tunnel, providing insight into why the tunnel last failed to establish or operate.";
    }
    leaf last-deactivate-reason {
      type mpls-te-ios-xe-oper:te-he-lsp-fail-reason;
      description
        "Specifies the reason for the most recent deactivation of the MPLS TE tunnel, detailing why the tunnel was last taken out of service.";
    }
    container tunnel-history {
      description
        "Contains historical information about the MPLS TE tunnel, including previous LSP instances, removal reasons, and election events.";
      uses mpls-te-ios-xe-oper:te-he-tunnel-history;
    }
    list tun-lsp {
      description
        "List of Label Switched Paths (LSPs) associated with the MPLS TE tunnel, representing the established paths for traffic engineering.";
      uses mpls-te-ios-xe-oper:te-he-tunnel-lsp;
    }
    leaf cfg-bw-kbps {
      type uint32;
      units "kbps";
      description
        "TE tunnel config bandwidth KBPS";
    }
    leaf request-bw-kbps {
      type uint32;
      units "kbps";
      description
        "TE tunnel request bandwidth KBPS";
    }
    leaf bw-sub-pool {
      type boolean;
      description
        "Indicates whether the TE tunnel uses a bandwidth sub pool for resource allocation, as opposed to the global bandwidth pool.";
    }
    container auto-bw-inf {
      description
        "Specifies the information related to automatic bandwidth adjustment feature for the TE tunnel.";
      uses mpls-te-ios-xe-oper:te-he-tunnel-auto-bw-info;
    }
    leaf auto-bw-enabled {
      type boolean;
      description
        "TE tunnel auto bandwidth enabled";
    }
    leaf auto-bw-minimum {
      type uint32;
      description
        "TE tunnel auto bandwidth minimum";
    }
    leaf auto-bw-maximum {
      type uint32;
      description
        "TE tunnel auto bandwidth maximum";
    }
    leaf bw-adjmnt-threshold {
      type uint32;
      description
        "Tunnel auto bandwidth threshold";
    }
    leaf bw-adjmnt-interval {
      type uint32;
      description
        "Tunnel auto bandwidth adjustment interval";
    }
    leaf bw-ovrflow-enabled {
      type boolean;
      description
        "Tunnel auto bandwidth overflow enabled";
    }
    leaf bw-ovrflow-threshold {
      type uint32;
      description
        "Tunnel auto bandwidth overflow threshold";
    }
    leaf bw-ovrflow-trigr-cnt {
      type uint32;
      description
        "Tunnel auto bandwidth overflow trigger count";
    }
    leaf setup-priority {
      type uint8;
      description
        "TE tunnel setup priority";
    }
    leaf hold-priority {
      type uint8;
      description
        "TE tunnel hold priority";
    }
    leaf affinity-val {
      type uint32;
      description
        "TE tunnel affinity value";
    }
    leaf affinity-mask {
      type uint32;
      description
        "TE tunnel affinity mask";
    }
    leaf tunnel-metric-type {
      type mpls-te-ios-xe-oper:te-he-tunnel-metric-type;
      description
        "TE tunnel metric type";
    }
    leaf metric-value {
      type uint32;
      description
        "TE tunnel metric value";
    }
    leaf tunnel-loadshare {
      type uint32;
      description
        "Specifies the load-sharing value for the TE tunnel, used to distribute traffic across multiple tunnels or paths.";
    }
    leaf autoroute-announce-en {
      type boolean;
      description
        "Indicates whether autoroute announce is enabled for the tunnel, allowing the tunnel to be advertised as a route in the IGP.";
    }
    leaf autoroute-announce {
      type boolean;
      description
        "Indicates if the tunnel is currently being announced as a route in the IGP (autoroute announce).";
    }
    leaf announce-fwdng-adj-en {
      type boolean;
      description
        "Indicates whether the tunnel is enabled to be announced as a forwarding adjacency in the IGP.";
    }
    leaf announce-fwdng-adj {
      type boolean;
      description
        "Indicates if the tunnel is currently being advertised as a forwarding adjacency in the IGP.";
    }
    leaf announce-dest-en {
      type boolean;
      description
        "Indicates whether the tunnel is enabled to announce its destination in the IGP.";
    }
    leaf announce-dest {
      type boolean;
      description
        "Indicates if the tunnel's destination is currently being advertised in the IGP.";
    }
    leaf frr-enabled {
      type boolean;
      description
        "TE fast re-route enabled";
    }
    leaf frr-bw-protect {
      type boolean;
      description
        "TE fast re-route bandwidth protect";
    }
    leaf frr-node-protect {
      type boolean;
      description
        "TE fast re-route node protect";
    }
    leaf tunnel-rro {
      type boolean;
      description
        "Indicates whether the Record Route Object (RRO) is enabled for this traffic engineering tunnel, allowing the recording of the path taken by the tunnel.";
    }
    leaf pcalc-tiebreaker {
      type mpls-te-ios-xe-oper:te-he-pcalc-tiebreaker-type;
      description
        "Specifies the tie-breaker method used when multiple equal-cost paths are available during TE tunnel path calculation.";
    }
    leaf pcalc-hop-limit {
      type uint8;
      description
        "Specifies the maximum number of hops allowed during TE tunnel path calculation.";
    }
    leaf pcalc-cost-limit {
      type uint32;
      description
        "Specifies the maximum cost allowed for a TE tunnel path during path calculation.";
    }
    leaf down-delay-secs {
      type uint32;
      units "seconds";
      description
        "Specifies the delay, in seconds, before declaring a TE tunnel as down after a failure is detected.";
    }
    leaf fa-hold-secs {
      type uint32;
      units "seconds";
      description
        "Specifies the hold time, in seconds, for the TE tunnel before it is released or re-evaluated after a failure or event.";
    }
    leaf inval-action {
      type mpls-te-ios-xe-oper:te-he-path-inval-action;
      description
        "Specifies the action to take when the TE tunnel path becomes invalid, such as tearing down the tunnel or dropping traffic.";
    }
    leaf sr-binding-sid {
      type uint32;
      description
        "TE tunnel segment routing binding ID";
    }
    leaf sr-path-type {
      type mpls-te-ios-xe-oper:te-he-sr-path-selection;
      description
        "TE tunnel segment routing path type";
    }
  }

  grouping te-lm-sub-lsp {
    description
      "TE link management sub LSP";
    leaf te-lm-slsp-not-used {
      type uint16;
      description
        "Indicates the number or identifier of sub Label Switched Paths (sub-LSPs) under TE link management that are not currently in use.";
    }
  }

  grouping te-lm-link-bw-thresholds {
    description
      "TE link management bandwidth threshold";
    leaf-list link-bw-up-thresholds {
      type uint8;
      ordered-by user;
      description
        "TE link bandwidth up threshold";
    }
    leaf-list link-bw-down-thresholds {
      type uint8;
      ordered-by user;
      description
        "TE link bandwidth down threshold";
    }
  }

  grouping te-lm-bw-pool-value {
    description
      "TE link management bandwidth pool value";
    leaf pool-bw-held {
      type uint64;
      units "bps";
      description
        "Amount of bandwidth currently held (reserved but not necessarily in use) in the sub pool for this TE link, measured in bits per second.";
    }
    leaf pool-bw-total-held {
      type uint64;
      units "bps";
      description
        "Total amount of bandwidth currently held (reserved but not necessarily in use) in the TE link bandwidth pool, measured in bits per second.";
    }
    leaf pool-bw-locked {
      type uint64;
      units "bps";
      description
        "Amount of bandwidth in the TE link bandwidth pool that is locked (committed and unavailable for other reservations), measured in bits per second.";
    }
    leaf pool-bw-total-locked {
      type uint64;
      units "bps";
      description
        "Total amount of bandwidth that is locked (committed and unavailable) in the TE link bandwidth pool, measured in bits per second.";
    }
  }

  grouping te-lm-bw-pool {
    description
      "TE link management bandwidth pool";
    leaf bw-pool-priority {
      type uint16;
      description
        "TE bandwidth pool priority";
    }
    container bw-pool-global {
      description
        "TE bandwidth pool global";
      uses mpls-te-ios-xe-oper:te-lm-bw-pool-value;
    }
    container bw-pool-sub-pool {
      description
        "Specifies the bandwidth information specific to the sub pool within the TE link bandwidth pool, used for managing reserved bandwidth at a sub-pool level.";
      uses mpls-te-ios-xe-oper:te-lm-bw-pool-value;
    }
  }

  grouping te-lm-link {
    description
      "TE link management link";
    leaf link-handle {
      type uint32;
      description
        "TE link handle";
    }
    leaf link-name {
      type string;
      description
        "Specifies the name assigned to the MPLS TE link, used for identification and management purposes.";
    }
    leaf link-ipaddress {
      type inet:ip-address;
      description
        "Specifies the IP address associated with the MPLS TE link.";
    }
    leaf link-local-if-id {
      type uint32;
      description
        "Identifier for the local interface associated with the MPLS TE link.";
    }
    leaf link-user-flags {
      type uint32;
      description
        "User-defined flags for the MPLS TE link, used to indicate custom link attributes or status.";
    }
    leaf link-user-admin-weight {
      type uint64;
      description
        "User-configured administrative weight for the MPLS TE link, used in path computation and selection.";
    }
    leaf link-is-lockout {
      type boolean;
      description
        "TE link is lock-out";
    }
    leaf link-lockout-on-time {
      type yang:date-and-time;
      description
        "Timestamp indicating when the MPLS TE link entered the lock-out state.";
    }
    leaf link-lockout-off-time {
      type yang:date-and-time;
      description
        "Timestamp indicating when the MPLS TE link exited the lock-out state.";
    }
    leaf link-agent-type {
      type mpls-te-ios-xe-oper:te-lm-link-agent-type;
      description
        "Specifies the agent type managing the MPLS TE link, such as RSVP or static TP.";
    }
    leaf link-bcid-type {
      type mpls-te-ios-xe-oper:te-lm-link-bcid-type;
      description
        "Specifies the Bandwidth Constraint Identifier (BCID) type for the MPLS TE link.";
    }
    leaf link-physical-bw {
      type uint64;
      units "bps";
      description
        "Specifies the total physical bandwidth capacity of the TE (Traffic Engineering) link in bits per second.";
    }
    leaf link-max-res-bw {
      type uint64;
      units "bps";
      description
        "Specifies the maximum reservable bandwidth for the TE link in bits per second, representing the highest bandwidth that can be reserved for traffic engineering purposes.";
    }
    leaf link-max-res-glbl-pool-bw {
      type uint64;
      description
        "TE link maximum global pool bandwidth";
    }
    leaf link-max-res-sub-pool-bw {
      type uint64;
      description
        "TE Link maximum sub pool bandwidth";
    }
    container link-bw-thresholds {
      description
        "Specifies the bandwidth threshold values for the TE link, used to trigger events or alarms when bandwidth usage crosses defined limits.";
      uses mpls-te-ios-xe-oper:te-lm-link-bw-thresholds;
    }
    leaf link-flow-bw-min {
      type uint64;
      units "bps";
      description
        "Specifies the minimum bandwidth, in bits per second, that can be allocated to a single flow on the TE link.";
    }
    leaf link-flow-bw-max {
      type uint64;
      units "bps";
      description
        "Specifies the maximum bandwidth, in bits per second, that can be allocated to a single flow on the TE link.";
    }
    leaf link-mtu {
      type uint16;
      units "bytes";
      description
        "Specifies the Maximum Transmission Unit (MTU) size, in bytes, for the TE link.";
    }
    leaf link-uplink-admit-method {
      type mpls-te-ios-xe-oper:te-lm-link-admit-method;
      description
        "Specifies the method used to admit traffic on the uplink for the TE (Traffic Engineering) link, such as bandwidth checking or allocation.";
    }
    leaf link-downlink-admit-method {
      type mpls-te-ios-xe-oper:te-lm-link-admit-method;
      description
        "Specifies the method used to admit traffic on the downlink for the TE (Traffic Engineering) link, such as bandwidth checking or allocation.";
    }
    leaf link-igp-admin-weight {
      type uint32;
      description
        "TE link IGP admin weight";
    }
    leaf link-igp-nbrs-flooded {
      type uint16;
      description
        "TE link IGP neighbors flooded";
    }
    leaf link-igp-nbr-count {
      type uint16;
      description
        "TE link IGP neighbor count";
    }
    leaf link-igp-subnet-type {
      type mpls-te-ios-xe-oper:te-lm-link-igp-subnet-type;
      description
        "TE link IGP subnet type";
    }
    list mpls-te-link-bw-pool {
      key "bw-pool-priority";
      description
        "TE link bandwidth pool";
      uses mpls-te-ios-xe-oper:te-lm-bw-pool;
    }
    list mpls-te-link-ingress-slsp {
      key "slsp-source-address slsp-destination-address slsp-tunnel-id slsp-lsp-id slsp-extended-ip-address slsp-p2mp-id slsp-p2mp-grp-id slsp-p2mp-grp-origin";
      description
        "TE link ingress sub-LSP";
      uses mpls-te-ios-xe-oper:te-sub-lsp-key;
      uses mpls-te-ios-xe-oper:te-lm-sub-lsp;
    }
    list mpls-te-link-egress-slsp {
      key "slsp-source-address slsp-destination-address slsp-tunnel-id slsp-lsp-id slsp-extended-ip-address slsp-p2mp-id slsp-p2mp-grp-id slsp-p2mp-grp-origin";
      description
        "List of sub-Label Switched Paths (sub-LSPs) associated with the egress direction of the TE link; each entry identifies one egress sub-LSP.";
      uses mpls-te-ios-xe-oper:te-sub-lsp-key;
      uses mpls-te-ios-xe-oper:te-lm-sub-lsp;
    }
  }

  container mpls-te-oper-data {
    config false;
    description
      "MPLS TE operational data";
    list mpls-te-sub-lsp {
      key "slsp-source-address slsp-destination-address slsp-tunnel-id slsp-lsp-id slsp-extended-ip-address slsp-p2mp-id slsp-p2mp-grp-id slsp-p2mp-grp-origin";
      description
        "MPLS TE sub LSP data";
      uses mpls-te-ios-xe-oper:te-sub-lsp-key;
      uses mpls-te-ios-xe-oper:te-sub-lsp;
    }
    list mpls-te-tunnel {
      key "tunnel-id";
      description
        "MPLS traffic engineering tunnel information";
      uses mpls-te-ios-xe-oper:te-he-tunnel;
    }
    list mpls-te-link {
      key "link-handle";
      description
        "MPLS traffic engineering link information";
      uses mpls-te-ios-xe-oper:te-lm-link;
    }
  }
}
