      }
      enum te-slsp-role-mid {
        value 1;
        description
          "Traffic engineering sub LSP role mid";
      }
      enum te-slsp-role-tail {
        value 2;
        description
          "Traffic engineering sub LSP role tail";
      }
    }
    description
      "TE sub LSP role";
  }

  typedef te-slsp-state {
