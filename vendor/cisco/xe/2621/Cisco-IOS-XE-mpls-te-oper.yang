  typedef te-lm-link-admit-method {
    type enumeration {
      enum link-admit-method-none {
        value 0;
        description
          "TE link admit method none";
      }
      enum link-admit-method-yes {
        value 1;
        description
          "TE link admit method yes";
      }
      enum link-admit-method-check-bw {
        value 2;
