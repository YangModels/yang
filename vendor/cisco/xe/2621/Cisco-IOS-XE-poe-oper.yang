      description
        "Indicates the operational policing state (such as power limiting or
         enforcement) for the Power over Ethernet (PoE) device on this port.";
    }
    leaf cutoff-power-police {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Specifies the maximum power (in Watts) that can be delivered to the
         device as enforced by the PoE policing mechanism.";
    }
    leaf power-negotiation-used {
      type poe-ios-xe-oper:power-neg-used;
      units "Watts";
      description
        "PoE power negotiation on this port using Protocols, such as
         CDP, LLDP-MED, IEEE 802.3 AT LLDP, or IEEE 802.3 BT LLDP.";
    }
    leaf four-pair-poe-supported {
      type boolean;
      description
        "Indicates whether four-pair Power over Ethernet (PoE) is supported
         by the connected powered device";
    }
    leaf four-pair-poe-enabled {
      type boolean;
      description
        "Indicates whether four-pair Power over Ethernet (PoE) is enabled on
         the connected powered device.";
    }
    leaf four-pair-pd-arch {
      type poe-ios-xe-oper:four-pair-pd-architecture;
      description
        "Type of four pair power device architecture.";
    }
    leaf over-current-counter {
      type uint32;
      description
        "Counter indicating the number of over-current events detected on the
         powered device.";
    }
    leaf short-current-counter {
      type uint32;
      description
        "Counter indicating the number of short-circuit current events
         detected on the powered device.";
    }
    leaf power-denied-counter {
      type uint32;
      description
        "Power device power denied counter";
    }
    leaf conn-type {
      type poe-ios-xe-oper:poe-conn-check;
      description
        "Connection type of power device";
    }
    container signal-pair-data {
      description
        "Signal pair inline power detail of power device";
      uses poe-ios-xe-oper:ilpower-pair-detail;
    }
    container spare-pair-data {
      description
        "Spare pair inline power detail of power device";
      uses poe-ios-xe-oper:ilpower-pair-detail;
    }
    leaf discovery {
      type poe-ios-xe-oper:ilpower-pd-discovery-protocol;
      description
        "Protocol used to discover the powered device (PD) on this PoE port, such as
         CDP, LLDP, or IEEE 802.3.";
    }
    container lldp-mdi-rx {
      description
        "Container for received LLDP (Link Layer Discovery Protocol) TLV
         fields related to Power over Ethernet (PoE) on this interface.";
      uses poe-ios-xe-oper:lldp-pwr-via-mdi-tlv;
    }
    container lldp-mdi-tx {
      description
        "Container for transmitted LLDP MED (Media Endpoint Discovery) Power
         over Ethernet (PoE) information on this interface";
      uses poe-ios-xe-oper:lldp-pwr-via-mdi-tlv;
    }
    container lldp-med-mdi-rx {
      description
        "PoE LLDP MED rx fields";
      uses poe-ios-xe-oper:lldp-med-pwr-via-mdi-tlv;
    }
    container lldp-med-mdi-tx {
      description
        "Container for transmitted LLDP MED (Media Endpoint Discovery) Power
         over Ethernet (PoE) information on this interface";
      uses poe-ios-xe-oper:lldp-med-pwr-via-mdi-tlv;
    }
    leaf fast-poe-enabled {
      type boolean;
      description
        "Indicates whether Fast PoE (Power over Ethernet) is enabled on the
         port, allowing power to be delivered to devices immediately upon
         switch startup";
    }
    leaf perpetual-poe-enabled {
      type boolean;
      description
        "Indicates whether Perpetual PoE (Power over Ethernet) is enabled on
         the port, allowing power to be maintained to connected devices during
         switch reload or reboot.";
    }
    leaf oper-priority {
      type poe-ios-xe-oper:port-oper-priority;
      description
        "Operational priority";
    }
    leaf post-done {
      type boolean;
      description
        "Status of PoE linecard initialization";
    }
    leaf upoe-plus-enabled {
      type boolean;
      description
        "Indicates whether UPOE Plus (Universal Power over Ethernet Plus) is
         enabled on the port, allowing delivery of higher power levels to
         connected devices";
    }
    leaf poe-intf-enabled {
      type boolean;
      description
        "Indicates whether Power over Ethernet (PoE) is administratively enabled on this interface.";
    }
    leaf module-id {
      type uint32;
      description
        "Module ID in stack";
    }
    leaf chassis-num {
      type uint32;
      description
        "Number identifying the chassis within a stack or modular switch system";
    }
    leaf prot-pd-highest-req-pwr {
      type decimal64 {
        fraction-digits 4;
      }
      units "Watts";
      description
        "Highest protocol requested power by a powered device ";
    }
    leaf prot-req-state {
      type poe-ios-xe-oper:pow-dev-prot-req-state;
      description
        "Indicates the current protocol request state of the powered device
         (PD) on this PoE port, showing the status of protocol negotiations
         such as IEEE 802.3af/at/bt.";
    }
    leaf pwr-state {
      type poe-ios-xe-oper:pow-dev-pwr-state;
      description
        "Power state of a powered device";
    }
    leaf meter-start-time {
      type yang:date-and-time;
      description
        "Timestamp of the start of metering period for energy calculations";
    }
    leaf metered-energy-value {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watt second";
      description
        "Energy consumed since meter start time";
    }
    leaf device-tag {
      type string;
      description
        "A user-defined or system-generated identifier assigned to the
         powered device connected to this PoE port for identification
         or management purposes";
    }
    leaf last-update-time {
      type yang:date-and-time;
      description
        "Timestamp of latest energy update";
    }
    leaf bucket-width {
      type uint16;
      units "Second";
      description
        "Bucket width in seconds";
    }
    leaf number-of-buckets {
      type uint8;
      description
        "Indicates the number of energy measurement buckets maintained for
         this PoE port, each representing a fixed time interval";
    }
    leaf-list poe-bucket {
      type uint32;
      units "Watt second";
      max-elements 12;
      ordered-by user;
      description
        "List of energy consumption values (in Watt seconds) for each
         measurement bucket, representing energy used by the powered
         device during each time interval";
    }
    leaf abs-cntr {
      type uint32;
      description
        "Power device absent counter";
    }
    leaf bad-sgn-cntr {
      type uint32;
      description
        "Counts the number of times a connected powered device has presented
         an invalid signature during Power over Ethernet (PoE) detection on
         this port";
    }
  }

  grouping poe-stack {
    description
      "POE stack grouping";
    leaf power-stack-name {
      type string;
      description
        "Name of the Power over Ethernet (PoE) stack";
    }
    leaf mode {
      type poe-ios-xe-oper:power-stack-mode;
      description
        "Stack mode";
    }
    leaf topolgy {
      type poe-ios-xe-oper:poe-stack-topo;
      description
        "Topology of the Power over Ethernet (PoE) stack";
    }
    leaf total-power {
      type int32;
      units "Watts";
      description
        "Stack total power, unit is Watts";
    }
    leaf rsvd-power {
      type int32;
      units "Watts";
      description
        "Stack reserved power, unit is Watts";
    }
    leaf alloc-power {
      type int32;
      units "Watts";
      description
        "Stack allocated power, unit is Watts";
    }
    leaf unused-power {
      type int32;
      units "Watts";
      description
        "Stack unused power, unit is Watts";
    }
    leaf num-sw {
      type uint8;
      description
        "Number of switches in the PoE stack";
    }
    leaf num-ps {
      type uint8;
      description
        "Number of power supplies in the PoE stack";
    }
  }

  grouping poe-switch {
    description
      "POE switch grouping";
    leaf switch-num {
      type uint8;
      description
        "Unique number identifying the switch within the PoE stack";
    }
    leaf power-budget {
      type uint16;
      units "Watts";
      description
        "Switch power budget, unit is Watts";
    }
    leaf power-allocated {
      type uint32;
      units "Watts";
      description
        "Switch allocated power, unit is Watts";
    }
    leaf low-port-priority {
      type uint8;
      description
        "Specifies the number of ports on the switch that are configured with
         low Power over Ethernet (PoE) priority";
    }
    leaf high-port-priority {
      type uint8;
      description
        "Specifies the number of ports on the switch that are configured with
         high Power over Ethernet (PoE) priority";
    }
    leaf switch-priority {
      type uint8;
      description
        "Indicates the Power over Ethernet (PoE) priority level assigned to
         the switch for power allocation decisions";
    }
    leaf port-one-status {
      type poe-ios-xe-oper:poe-port-status;
      description
        "Indicates the Power over Ethernet (PoE) operational status of
         port 1 on the switch";
    }
    leaf port-two-status {
      type poe-ios-xe-oper:poe-port-status;
      description
        "Indicates the Power over Ethernet (PoE) operational status of
         port 2 on the switch";
    }
    leaf neighbor-on-port-one {
      type yang:mac-address;
      description
        "MAC address of the neighboring device connected to port 1
         of the switch";
    }
    leaf neighbor-on-port-two {
      type yang:mac-address;
      description
        "MAC address of the neighboring device connected to port 2
         of the switch";
    }
    leaf consumed-switch-power {
      type uint32;
      units "Watts";
      description
        "Consumed switch power, unit is Watts";
    }
    leaf consumed-high-power {
      type uint32;
      units "Watts";
      description
        "Consumed high power, unit is Watts";
    }
    leaf consumed-low-power {
      type uint32;
      units "Watts";
      description
        "Consumed low power, unit is Watts";
    }
    leaf allocated-high-power {
      type uint32;
      units "Watts";
      description
        "Specifies the total amount of high power allocated to PoE devices on
         this switch, measured in Watts";
    }
    leaf allocated-low-power {
      type uint32;
      units "Watts";
      description
        "Specifies the total amount of low power allocated to PoE devices on
         this switch, measured in Watts";
    }
    leaf ps-a {
      type uint16;
      units "Watts";
      description
        "Indicates the output power of power supply A (PS-A) for this switch,
         measured in Watts.";
    }
    leaf ps-b {
      type uint16;
      units "Watts";
      description
        "Indicates the output power of power supply B (PS-B) for this switch,
         measured in Watts.";
    }
    leaf available-power {
      type int32;
      units "Watts";
      description
        "Indicates the total power available for PoE device allocation on
         this switch, measured in Watts";
    }
    leaf consumed-system-power {
      type int32;
      units "Watts";
      description
        "Indicates the total power consumed by the switch system, including
         all components, measured in Watts";
    }
    leaf consumed-poe-power {
      type int32;
      units "Watts";
      description
        "Indicates the total power consumed by all PoE devices connected
         to this switch, measured in Watts";
    }
    leaf power-stack-name {
      type string;
      description
        "The name of the power stack that this switch belongs to";
    }
    leaf ps-c {
      type uint16;
      units "Watts";
      description
        "Power supply in slot C, unit is Watts";
    }
    leaf avail-sys-pwr {
      type uint16;
      units "Watts";
      description
        "Remaining system power available after deducting the power consumed
         by PoE devices on this switch, in Watts.";
    }
  }

  container poe-oper-data {
    config false;
    description
      "Operational data for Power over Ethernet (PoE) features on the device";
    list poe-port {
      key "intf-name";
      status obsolete;
      description
        "Legacy list of PoE interfaces, keyed by interface name. This list is obsolete.";
      uses poe-ios-xe-oper:poe-ethernet;
    }
    list poe-port-detail {
      key "intf-name";
      description
        "List of PoE interfaces, keyed by interface name";
      uses poe-ios-xe-oper:poe-data-ethernet;
    }
    list poe-module {
      key "module";
      description
        "List of PoE modules, keyed by module number";
      uses poe-ios-xe-oper:poe-module;
    }
    list poe-stack {
      key "power-stack-name";
      description
        "List of PoE stacks, keyed by stack name";
      uses poe-ios-xe-oper:poe-stack;
    }
    list poe-switch {
      key "switch-num";
      description
        "List of PoE switches, keyed by switch number";
      uses poe-ios-xe-oper:poe-switch;
    }
  }
}
