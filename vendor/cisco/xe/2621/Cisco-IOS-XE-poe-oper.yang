  typedef ilpower-lldp-med-power-priority {
    type enumeration {
      enum lldp-med-power-priority-unknown {
        value 0;
        description
          "Power priority is unknown";
      }
      enum lldp-med-power-priority-critical {
        value 1;
        description
          "Power priority is critical";
      }
      enum lldp-med-power-priority-high {
        value 2;
        description
          "Power priority is high";
      }
      enum lldp-med-power-priority-low {
        value 3;
        description
          "Power priority is low";
      }
      enum lldp-med-power-priority-invalid {
        value 4;
        description
          "Power priority is invalid";
      }
    }
    description
      "ilpower LLDP MED power priority";
  }

  typedef ilpower-module-type {
    type enumeration {
      enum module-type-fixed {
        value 0;
        description
          "Fixed type chassis";
      }
      enum module-type-modular {
        value 1;
        description
          "Modular type chassis";
      }
    }
    description
      "Chassis type";
  }

  typedef pow-dev-prot-req-state {
    type enumeration {
      enum proto-unknown {
        value 0;
        description
          "Protocol is unknown or not available";
      }
      enum proto-granted {
        value 1;
        description
          "Protocol request is granted";
      }
      enum proto-in-prog {
        value 2;
        description
          "Protocol request is in progress";
      }
    }
    description
      "Powered device protocol request state";
  }

  typedef pow-dev-pwr-state {
    type enumeration {
      enum pow-dev-no-power {
        value 0;
        description
          "Powered device is not powered";
      }
      enum pow-dev-fully-powered {
        value 1;
        description
          "Powered device is fully powered";
      }
      enum pow-dev-partially-powered {
        value 2;
        description
          "Powered device is partially powered";
      }
    }
    description
      "Power state of powered device";
  }

  typedef power-stack-mode {
    type enumeration {
      enum stack-mode-rps {
        value 0;
        description
          "Stack mode is redundant power supply";
      }
      enum stack-mode-sharing-strict {
        value 1;
        description
          "Stack mode is sharing strict";
      }
      enum stack-mode-sharing {
        value 2;
        description
          "Stack mode is sharing";
      }
      enum stack-mode-redundant-strict {
        value 3;
        description
          "Stack mode is redundant strict";
      }
      enum stack-mode-redundant {
        value 4;
        description
          "Stack mode is redundant";
      }
      enum stack-mode-null {
        value 5;
        description
          "Stack mode is not available";
      }
    }
    description
      "Mode if power stack";
  }

  typedef poe-stack-topo {
    type enumeration {
      enum stack-topo-none {
        value 0;
        description
          "Stack topology is none";
      }
      enum stack-topo-star {
        value 1;
        description
          "Stack topology is star";
      }
      enum stack-topo-standalone {
        value 2;
        description
          "Stack topology is standalone";
      }
      enum stack-topo-ring {
        value 3;
        description
          "Stack topology is ring";
      }
    }
    description
      "Poe stack topology";
  }

  typedef poe-port-status {
    type enumeration {
      enum stack-port-status-unknown {
        value 0;
        description
          "Stack port status is unknown";
      }
      enum stack-port-status-shut {
        value 1;
        description
          "Stack port status is shutdown";
      }
      enum stack-port-status-connected {
        value 2;
        description
          "Stack port status is connected";
      }
      enum stack-port-status-not-connected {
        value 3;
        description
          "Stack port status is not connected";
      }
    }
    description
      "Stack port status";
  }

  grouping poe-module {
    description
      "PoE module grouping containing operational data for a Power
       over Ethernet module";
    leaf module {
      type uint32;
      description
        "Module number";
    }
    leaf available-power {
      type decimal64 {
        fraction-digits 2;
      }
      description
        "Available power of module";
    }
    leaf used-power {
      type decimal64 {
        fraction-digits 2;
      }
      description
        "Used power of module";
    }
    leaf remaining-power {
      type decimal64 {
        fraction-digits 2;
      }
      description
        "Remaining power of module";
    }
    leaf chassis-num {
      type uint32;
      description
        "The unique identifier number assigned to the chassis of
         the switch containing this PoE module";
    }
    leaf power-pool-idx {
      type uint32;
      description
        "Index identifying the power pool to which this PoE module is
         assigned for power allocation and management";
    }
    leaf num-ports {
      type uint32;
      description
        "Total number of PoE ports";
    }
    leaf used-ports {
      type uint32;
      description
        "Number of used PoE ports";
    }
    leaf free-ports {
      type uint32;
      description
        "Number of free PoE ports";
    }
    leaf module-type {
      type poe-ios-xe-oper:ilpower-module-type;
      description
        "Type of Power over Ethernet (PoE) module or chassis";
    }
    leaf if-max-power {
      type decimal64 {
        fraction-digits 2;
      }
      description
        "Max power drawn on an interface";
    }
    leaf tot-consumed-pwr-valid {
      type empty;
      description
        "Total consumed power is valid";
    }
    leaf tot-consumed-pwr {
      when 'boolean(../tot-consumed-pwr-valid)';
      type decimal64 {
        fraction-digits 4;
      }
      units "Watts";
      description
        "Total power consumed by module";
    }
    leaf bt-reload-pending {
      type boolean;
      description
        "Indicates whether a reload is required to switch the module
         to IEEE 802.3 BT mode.";
    }
    leaf flex-poe-config {
      type boolean;
      description
        "Indicates whether flexible PoE is configured on PoE module";
    }
    leaf flex-poe-actv {
      type boolean;
      description
        "Indicates whether flexible PoE is currently active on PoE module";
    }
  }

  grouping ilp-port-config-details {
    description
      "Ilp port config details";
    leaf initialization {
      type boolean;
      description
        "Status of Port initialization";
    }
    leaf ilp-supported {
      type boolean;
      description
        "Status of Inline power supported";
    }
    leaf ilp-enabled {
      type boolean;
      description
        "Status of Inline power enabled";
    }
    leaf post {
      type boolean;
      description
        "Status of PoE linecard initialization";
    }
    leaf power-on {
      type boolean;
      description
        "Indicates whether power is currently being supplied to the connected
         device via PoE on this port";
    }
    leaf power-denied {
      type boolean;
      description
        "Indicates whether power delivery via PoE has been denied on this port";
    }
    leaf state {
      type poe-ios-xe-oper:power-state;
      description
        "Current operational state of PoE port";
    }
    leaf short-circuit-detected {
      type uint32;
      description
        "Count of short-circuit events detected on this PoE port.";
    }
    leaf spare-pair-mode {
      type poe-ios-xe-oper:poe-upoe-cmd-mode;
      description
        "Indicates the operational mode for spare pair power delivery (UPOE)
         on this PoE port";
    }
    leaf spare-pair-power-is-on {
      type boolean;
      description
        "Indicates whether power is being supplied over the spare wire pairs
         on this PoE port";
    }
    leaf pd-power-state {
      type poe-ios-xe-oper:ilpower-pd-power-state;
      description
        "Indicates the current power state of the powered device (PD) connected
         to this PoE port";
    }
  }

  grouping ilpower-detail {
    description
      "POE ethernet details";
    leaf oper-status {
      type poe-ios-xe-oper:ilpower-device-state;
      description
        "Operational state of the powered device (PD) connected to this PoE port.";
    }
    leaf device-detected {
      type boolean;
      description
        "Indicates whether a powered device (PD) is detected on this PoE port.";
    }
    leaf device-name {
      type string;
      description
        "Name or model identifier reported by the powered device (PD) connected to this PoE port.";
    }
    leaf discovery {
      type poe-ios-xe-oper:ilpower-pd-discovery-protocol;
      description
        "Protocol used to discover the powered device (PD) on this PoE port, such as
         CDP, LLDP, or IEEE 802.3.";
    }
    leaf police-state-on {
      type boolean;
      description
        "Indicates whether power policing is enabled on this PoE port.";
    }
    leaf power-admin-max {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Maximum power (in Watts) that the administrator has configured for this PoE port.";
    }
    leaf power-from-pse {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Amount of power, in Watts, supplied by the Power Sourcing Equipment (PSE)
         to the PoE port.";
    }
    leaf power-to-pd {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Amount of power, in Watts, delivered from this PoE port to the powered device (PD).";
    }
    leaf power-consumption {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Actual power consumed by the powered device (PD) on this port, in Watts.";
    }
    leaf max-power-drawn {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Maximum power drawn by the powered device (PD) on this port since the last reset, in Watts.";
    }
    leaf power-negotiation-used {
      type string;
      units "Watts";
      description
        "PoE power negotiation on this port using Protocols, such as
         CDP, LLDP-MED, IEEE 802.3 AT LLDP, or IEEE 802.3 BT LLDP.";
    }
    leaf lldp-tx-power-type {
      type poe-ios-xe-oper:poe-lldp-power-type;
      description
        "LLDP power negotiation power type sent to the powered device (PD).";
    }
    leaf lldp-tx-power-source {
      type poe-ios-xe-oper:poe-lldp-power-source;
      description
        "LLDP power negotiation power source sent to the powered device (PD).";
    }
    leaf lldp-tx-power-priority {
      type poe-ios-xe-oper:poe-lldp-power-priority;
      description
        "LLDP power negotiation power priority sent to the powered device (PD).";
    }
    leaf lldp-tx-power-requested {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Amount of power (in Watts) requested via LLDP negotiation and sent to the powered device (PD).";
    }
    leaf lldp-tx-power-allocated {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Amount of power (in Watts) allocated via LLDP negotiation and sent to the powered device (PD).";
    }
    leaf lldp-rx-power-type {
      type poe-ios-xe-oper:poe-lldp-power-type;
      description
        "LLDP power negotiation power type received from power device.";
    }
    leaf lldp-rx-power-source {
      type poe-ios-xe-oper:poe-lldp-power-source;
      description
        "LLDP power negotiation power source received from power device.";
    }
    leaf lldp-rx-power-priority {
      type poe-ios-xe-oper:poe-lldp-power-priority;
      description
        "LLDP power negotiation power priority received from power device.";
    }
    leaf lldp-rx-power-requested {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Amount of power (in Watts) requested by the powered device (PD) and received
         via LLDP negotiation.";
    }
    leaf lldp-rx-power-allocated {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Amount of power (in Watts) allocated to this port as reported by the powered
         device (PD) via LLDP negotiation.";
    }
    leaf four-pair-poe-supported {
      type string;
      description
        "Indicates whether four-pair Power over Ethernet (PoE) is supported
         by the connected powered device";
    }
    leaf four-pair-poe-enabled {
      type string;
      description
        "Indicates whether four-pair Power over Ethernet (PoE) is enabled on
         the connected powered device.";
    }
    leaf four-pair-pd-arch {
      type string;
      description
        "Type of four pair power device architecture.";
    }
    leaf over-current-counter {
      type uint32;
      description
        "Counter indicating the number of over-current events detected on the
         powered device.";
    }
    leaf short-current-counter {
      type uint32;
      description
        "Counter indicating the number of short-circuit current events
         detected on the powered device.";
    }
  }

  grouping poe-ethernet {
    description
      "POE ethernet grouping";
    leaf intf-name {
      type string;
      description
        "Name of the PoE interface.";
    }
    leaf poe-intf-enabled {
      type boolean;
      description
        "Indicates whether Power over Ethernet (PoE) is administratively enabled on this interface.";
    }
    leaf power-used {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Amount of power consumed by the powered device (PD) on this port, in Watts.";
    }
    leaf pd-class {
      type poe-ios-xe-oper:ilpower-pd-class;
      description
        "IEEE 802.3 power class of the powered device (PD), which determines the maximum power
         the device may draw.";
    }
    leaf oper-state {
      type poe-ios-xe-oper:ilpower-pd-power-state;
      description
        "Current operational power state of the powered device (PD) on this PoE port.";
    }
    leaf admin-state {
      type poe-ios-xe-oper:ilpower-admin-state;
      description
        "Administrative state of PoE power delivery to the powered device (PD) on this port.";
    }
    leaf oper-power {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Operational power of the powered device, in Watts.";
    }
    leaf admin-police {
      type string;
      description
        "Administrative state of power policing for the Powered
         Device (PD) on the PoE port.";
    }
    leaf oper-police {
      type string;
      description
        "Indicates the operational policing state (such as power limiting or
         enforcement) for the Power over Ethernet (PoE) device on this port.";
    }
    leaf cutoff-power-police {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Specifies the maximum power (in Watts) that can be delivered to the
         device as enforced by the PoE policing mechanism.";
    }
    leaf module {
      type uint32;
      description
        "Indicates the module number or identifier associated with this Power
         over Ethernet (PoE) device.";
    }
    container ilp-detail {
      description
        "Container for detailed inline power (PoE) operational data for the
         powered device (PD) on this port.";
      uses poe-ios-xe-oper:ilpower-detail;
    }
    container port-poe-detail {
      description
        "Detailed operational information about the Power over Ethernet (PoE)
         configuration and status for this port.";
      uses poe-ios-xe-oper:ilp-port-config-details;
    }
  }

  grouping ilpower-pair-detail {
    description
      "PoE signal/spare details";
    leaf pd-class {
      type poe-ios-xe-oper:poe-pd-class;
      description
        "Class of the power device";
    }
    leaf assigned-pd-class {
      type poe-ios-xe-oper:poe-pd-class;
      description
        "Assigned class of the power device";
    }
    leaf oper-power {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Operational power of the powered device, in Watts.";
    }
    leaf power-from-pse {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Amount of power, in Watts, supplied by the Power Sourcing Equipment (PSE)
         to the PoE port.";
    }
    leaf power-to-pd {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Amount of power, in Watts, delivered from this PoE port to the powered device (PD).";
    }
    leaf oper-state {
      type poe-ios-xe-oper:poe-pd-power-state;
      description
        "Current operational power state of the powered device (PD) on this PoE port.";
    }
  }

  grouping lldp-med-pwr-via-mdi-tlv {
    description
      "LLDP MED  power fields from mdi tlv";
    leaf power-type {
      type poe-ios-xe-oper:ilpower-lldp-med-power-type;
      description
        "LLDP MED power negotiation power type";
    }
    leaf power-source {
      type poe-ios-xe-oper:ilpower-lldp-med-power-source;
      description
        "LLDP MED power negotiation power source";
    }
    leaf power-priority {
      type poe-ios-xe-oper:ilpower-lldp-med-power-priority;
      description
        "Priority level assigned to the port during LLDP MED power
         negotiation, determining the precedence of power allocation
         among connected devices";
    }
  }

  grouping lldp-pwr-via-mdi-tlv {
    description
      "LLDP power fields from mdi tlv";
    leaf power-type {
      type poe-ios-xe-oper:poe-lldp-power-type;
      description
        "LLDP power negotiation power type";
    }
    leaf power-source {
      type poe-ios-xe-oper:ilpower-lldp-power-source;
      description
        "Indicates the power source type as negotiated via LLDP for this port
         (e.g., whether the device is powered by a local or remote source)";
    }
    leaf power-priority {
      type poe-ios-xe-oper:poe-lldp-power-priority;
      description
        "Priority level assigned to the port during LLDP power negotiation,
         determining the precedence for power allocation among connected devices";
    }
    leaf power-requested {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "LLDP power negotiation power request";
    }
    leaf power-allocated {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Amount of power (in Watts) allocated to the Powered Device (PD) by
         the Power Sourcing Equipment (PSE) during LLDP power negotiation";
    }
    leaf pd-4pid {
      type uint8;
      description
        "local PD system supports powering of both pairs";
    }
    leaf length {
      type uint16;
      units "bytes";
      description
        "Specifies the length, in bytes, of the LLDP Power via MDI TLV
         received on this port";
    }
    leaf pd-req-pwr-mode-a {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "PD requested power for mode A";
    }
    leaf pd-req-pwr-mode-b {
      type decimal64 {
        fraction-digits 2;
      }
      description
        "PD requested power for mode B";
    }
    leaf pse-alloc-pwr-mode-a {
      type decimal64 {
        fraction-digits 2;
      }
      description
        "PSE allocated power value for mode A";
    }
    leaf pse-alloc-pwr-mode-b {
      type decimal64 {
        fraction-digits 2;
      }
      description
        "PSE allocated power value for mode B";
    }
    leaf pse-pwring-status {
      type poe-ios-xe-oper:pse-lldp-pwr-status;
      description
        "Indicates the current power delivery status of the Power Sourcing
         Equipment (PSE) on this port, such as whether it is supplying power,
         not supplying power, or in a fault state.";
    }
    leaf pd-pwred-status {
      type poe-ios-xe-oper:pd-lldp-pwr-status;
      description
        "Indicates the current power status of the Powered Device (PD) on
         this port, such as whether receiving power, not receiving power,
         or in a fault state";
    }
    leaf pse-pwr-pair-ext {
      type poe-ios-xe-oper:lldp-pse-pwr-ext-type;
      description
        "Specifies the supported Power Sourcing Equipment (PSE) pinout
         alternative (e.g., Alternative A or B) for delivering power as
         reported via LLDP";
    }
    leaf dual-sig-pwr-class-mode-a {
      type poe-ios-xe-oper:dual-sig-pwr-class;
      description
        "Power class on Dual signature PD for Alt A ";
    }
    leaf dual-sig-pwr-class-mode-b {
      type poe-ios-xe-oper:dual-sig-pwr-class;
      description
        "Power class on Dual signature PD for Alt B ";
    }
    leaf pwr-ss-class-ext {
      type poe-ios-xe-oper:ss-pwr-class;
      description
        "Indicates the power class of a single-signature powered
         device (PD) as reported via LLDP";
    }
    leaf pwr-type-ext {
      type poe-ios-xe-oper:lldp-power-ext;
      description
        "Specifies the type of Power Sourcing Equipment (PSE) power being
         provided on this port, such as Type 1 (15.4W), Type 2 (30W), or other
         IEEE 802.3 power types";
    }
    leaf pse-max-available-power {
      type decimal64 {
        fraction-digits 2;
      }
      units "Watts";
      description
        "Indicates the maximum amount of power (in Watts) that the Power
         Sourcing Equipment (PSE) can provide on this port.";
    }
    leaf pse-auto-class-support {
      type boolean;
      description
        "Indicates whether the power sourcing equipment (PSE) supports the
         Auto Class feature as reported via LLDP";
    }
    leaf auto-class-comp {
      type boolean;
      description
        "Whether the PSE has completed Auto class measurement";
    }
    leaf auto-class-req {
      type boolean;
      description
        "Indicates whether the powered device (PD) is requesting an auto class
         measurement and power budget adjustment via LLDP.";
    }
    leaf pwr-down-req {
      type boolean;
      description
        "Indicates whether the powered device (PD) is requesting to be
         powered down via LLDP";
    }
    leaf power-down-time {
      type uint64;
      description
        "Amount of seconds the power device requests to stay powered off";
    }
  }

