module ietf-comparability-scope {
  yang-version 1.1;
  namespace
    "urn:ietf:params:xml:ns:yang:ietf-comparability-scope";
  prefix csc;

  organization
    "IETF NETMOD (Network Modeling) Working Group";
  contact
    "WG Web:   <https://datatracker.ietf.org/wg/netmod/>
     WG List:  <mailto:netmod@ietf.org>

     Author:   Saumya Dikshit
               <mailto:saumya.dikshit@hpe.com>";
  description
    "This module defines two YANG extension statements,
     'comparability-scope' and 'domain-id-ref', that let a module
     author declare the scope over which a measured, counted, or
     identifying value is unique and comparable to other readings
     of the same value.

     Copyright (c) 2026 IETF Trust and the persons identified as
     authors of the code.  All rights reserved.

     Redistribution and use in source and binary forms, with or
     without modification, is permitted pursuant to, and subject to
     the license terms contained in, the Revised BSD License set
     forth in Section 4.c of the IETF Trust's Legal Provisions
     Relating to IETF Documents
     (https://trustee.ietf.org/license-info).

     This version of this YANG module is part of RFC XXXX
     (https://www.rfc-editor.org/info/rfcXXXX); see the RFC itself
     for full legal notices.";

  revision 2026-11-23 {
    description
      "Initial revision.";
    reference
      "RFC XXXX: A YANG Extension for Declaring the Comparability
       Scope of Operational State";
  }

  extension comparability-scope {
    argument scope-value;
    description
      "Attached to a leaf or leaf-list representing a measured,
       counted, or identifying value, this statement declares the
       scope within which two readings of that value are
       comparable (summed, differenced, or averaged).

       The 'scope-value' argument must be one of 'node-local',
       'domain-local', 'controller-scoped', or 'global', ordered
       from narrowest to widest.

       When 'scope-value' is 'domain-local', at least one
       'domain-id-ref' statement must be present on the same leaf
       or leaf-list to identify the domain within which the value
       is unique.

       Widening the declared scope of an existing leaf, for example
       from 'node-local' to 'domain-local', is a
       non-backward-compatible change and is handled per the module
       update rules of RFC 8407.";
  }

  extension domain-id-ref {
    argument domain-xpath;
    description
      "A sibling statement of 'comparability-scope' on the same
       leaf or leaf-list.  Its 'domain-xpath' argument is a
       relative XPath expression, evaluated with the annotated leaf
       or leaf-list as the context node, that resolves to the leaf
       identifying the domain within which the annotated value is
       unique.

       More than one 'domain-id-ref' statement may be present; the
       set of referenced leaves then forms a compound domain key,
       and two readings are in the same domain only when every
       referenced leaf resolves to an equal value.";
  }
}
