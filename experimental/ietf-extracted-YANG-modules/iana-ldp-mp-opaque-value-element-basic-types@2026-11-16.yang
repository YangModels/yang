module iana-ldp-mp-opaque-value-element-basic-types {

  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
            + "iana-ldp-mp-opaque-value-element-basic-types";
  prefix iana-mldp-opaque-element-basic-types;

  organization "IANA";
  contact
    "Internet Assigned Numbers Authority

     Postal: ICANN
          12025 Waterfront Drive, Suite 300
          Los Angeles, CA  90094-2536
          United States of America
     Tel:    +1 310 301 5800
     <mailto:iana@iana.org>";
  description
    "This module contains a collection of IANA-maintained YANG
     data types as defined in 'LDP MP Opaque Value Element
     basic type' IANA registry.

     This module is available from the IANA YANG Parameters registry
     (https://www.iana.org/assignments/yang-parameters).

     Copyright (c) 2026 IETF Trust and the persons identified as
     authors of the code.  All rights reserved.

     Redistribution and use in source and binary forms, with or
     without modification, is permitted pursuant to, and subject
     to the license terms contained in, the Revised BSD License
     set forth in Section 4.c of the IETF Trust's Legal Provisions
     Relating to IETF Documents
     (https://trustee.ietf.org/license-info).

     This version of this YANG module is part of RFC XXX; see
     the RFC itself for full legal notices.";
     // RFC editor: Please replace XXX with this document RFC number

  revision 2026-11-16 {
    description "First revision.";
    reference
      "RFC XXX: A YANG Data Model for MPLS mLDP.";
  }
  // RFC editor: Please replace XXX with this document RFC number

  identity iana-ldp-mp-opaque-value-element-basic-type {
    description
      "Base identity for LDP MP Opaque Value Element basic type.";
    reference
      "LDP Parameters IANA registry for LDP MP Opaque Value Element
       basic type";
  }

  identity lspid {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Generic LSP identifier type";
    reference "RFC 6388";
  }

  identity transit-source-v4 {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Transit IPv4 Source TLV type";
    reference "RFC 6826";
  }

  identity transit-source-v6 {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Transit IPv6 Source TLV type";
    reference "RFC 6826";
  }

  identity transit-bidir-v4 {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Transit IPv4 Bidir TLV type";
    reference "RFC 6826";
  }

  identity transit-bidir-v6 {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Transit IPv6 Bidir TLV type";
    reference "RFC 6826";
  }

  identity recur-opaque {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Recursive Opaque value";
    reference "RFC 6512";
  }

  identity recur-opaque-vpn {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "VPN-Recursive Opaque value";
    reference "RFC 6512";
  }

  identity transit-bidir-vpnv4 {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Transit VPNv4 Bidir TLV type";
    reference "RFC 7246";
  }

  identity transit-bidir-vpnv6 {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Transit VPNv6 Bidir TLV type";
    reference "RFC 7246";
  }

  identity transit-shared-v4 {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Transit IPv4 Shared Tree TLV";
    reference "RFC 7442";
  }

  identity transit-shared-v6 {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Transit IPv6 Shared Tree TLV";
    reference "RFC 7442";
  }

  identity l2vpn-mcast-app {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "L2VPN-MCAST application TLV";
    reference "RFC 8338";
  }

  identity transit-source-vpnv4 {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Transit VPNv4 Source TLV type";
    reference "RFC 7246";
  }

  identity transit-source-vpnv6 {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Transit VPNv6 Source TLV type";
    reference "RFC 7246";
  }

  identity extended-type-is-present {
    base iana-ldp-mp-opaque-value-element-basic-type;
    description "Extended Type field is present in the
                following two bytes";
    reference "RFC 6388";
  }

} // module
