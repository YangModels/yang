module ietf-yp-current-period {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:ietf-yp-current-period";
  prefix yp-cp;

  import ietf-subscribed-notifications {
    prefix sn;
    reference
      "RFC 8639: Subscription to YANG Notifications";
  }
  import ietf-yang-push {
    prefix yp;
    // RFC Ed.: remove revision-date, needed here for datatracker
    // to properly validate the module, because the latest version
    // on the server is not the ratified one and validation fails.
    revision-date 2019-09-09;
    reference
      "RFC 8641: Subscription to YANG Notifications for Datastore
       Updates";
  }

  organization
    "IETF OPSAWG (Operations and Management Area Working Group)";
  contact
    "WG Web:   <https://datatracker.ietf.org/wg/opsawg/>
     WG List:  <mailto:opsawg@ietf.org>
     Author:   Benoit Claise   <mailto:benoit@everything-ops.net>
     Author:   Jean Quilbeuf   <mailto:jean.quilbeuf@huawei.com>
     Author:   Diego R. Lopez  <mailto:diego.r.lopez@telefonica.com>
     Author:   Ignacio Dominguez Martinez-Casanueva
     <mailto:i.domingumar@gmail.com>
     Author:   Thomas Graf     <mailto:thomas.graf@swisscom.com>";
  description
    "This module augments ietf-subscribed-notifications and
     ietf-yang-push with the current-period leaf reporting the actual
     collection period, as opposed to the configured one.

     Copyright (c) 2026 IETF Trust and the persons identified as
     authors of the code.  All rights reserved.

     Redistribution and use in source and binary forms, with or
     without modification, is permitted pursuant to, and subject
     to the license terms contained in, the Revised BSD License
     set forth in Section 4.c of the IETF Trust's Legal Provisions
     Relating to IETF Documents
     (https://trustee.ietf.org/license-info).
     All revisions of IETF and IANA published modules can be found
     at the YANG Parameters registry group
     (https://www.iana.org/assignments/yang-parameters).

     This version of this YANG module is part of RFC XXXX; see the
     RFC itself for full legal notices.";

  revision 2026-10-24 {
    description
      "Initial revision";
    reference
      "RFC XXXX: A Data Manifest for Contextualized Telemetry Data";
  }

  augment "/sn:subscriptions/sn:subscription"
        + "/yp:update-trigger/yp:periodic/yp:periodic" {
    description
      "Adds current collection period";
    leaf current-period {
      type yp:centiseconds;
      units "centiseconds";
      config false;
      description
        "The period currently used between two successive observation
         times of the subscribed data for a periodic subscription,
         i.e., the realized collection period. It may differ from the
         configured 'period' (RFC 8641) when the publisher cannot
         meet the configured cadence, for instance under overload.
         When this leaf is not reported for a periodic subscription,
         the configured 'period' is in effect. A reported value is a
         positive period; the value zero is not meaningful.";
    }
  }
}

